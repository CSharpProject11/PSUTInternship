<%@ Page Language="C#" Async="true" AutoEventWireup="true" CodeBehind="CompletionReview.aspx.cs" Inherits="PSUTInternship.Admin.CompletionReview" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Final completion review | PSUT</title><link href="../Content/vendor/bootstrap.min.css" rel="stylesheet"/><link href="../Content/portal.css" rel="stylesheet"/></head><body><main class="container py-5"><a href="Dashboard.aspx">Coordinator dashboard</a><h1 class="mt-4">Final completion review</h1><p>Review both evaluations and approved hours before issuing a completion report.</p><form id="form1" runat="server"><asp:Label ID="notice" runat="server" role="status"/><asp:Repeater ID="reviews" runat="server" OnItemCommand="reviews_ItemCommand"><ItemTemplate><section class="border-bottom py-4"><h2><%#: Eval("Name") %></h2><p>Training hours: <%#: Eval("Hours") %> | Company score: <%#: Eval("CompanyScore") %> | Academic score: <%#: Eval("AcademicScore") %></p><p>Company feedback: <%#: Eval("CompanyComments") %></p><p>Academic feedback: <%#: Eval("AcademicComments") %></p><p>Recommendation: <%#: Eval("Recommendation") %> | Review status: <%#: Eval("Status") %></p><asp:Button runat="server" Text="Approve completion" CommandName="Approve" CommandArgument='<%# Eval("Id") %>' CssClass="btn btn-primary"/><a class="btn btn-link" href='<%# "../CompletionReport.aspx?studentId=" + Server.UrlEncode(Convert.ToString(Eval("StudentId"))) %>'>Download approved report</a></section></ItemTemplate></asp:Repeater><asp:Label ID="empty" runat="server" Text="No evaluations have been forwarded for review yet."/></form></main></body></html>

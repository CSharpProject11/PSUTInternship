<%@ Master Language="C#" AutoEventWireup="false" CodeFile="TestLayout.cs" Inherits="Preview.TestLayout" %>
<!doctype html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My workspace · PSUT Internship Portal</title>
    <link rel="icon" href="<%= ResolveUrl("~/Assets/psut-logo.jpg") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/workspace.css") %>" />
</head>
<body class="workspace" data-role="<%: Role %>">
<svg class="wd-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-bag" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="3"/><path d="M8 7V4h8v3M3 12h18M10 12v3h4v-3"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 4v16h17M8 15v-4m5 4V7m5 8v-6"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
<symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v11H3zM9 21v-8h6v8"/></symbol>
<symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 9a3 3 0 1 1 4 3c-1 .5-1 1-1 2m0 3h.01"/></symbol>
<symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 7V3l-4 4a8 8 0 1 0 3 10M20 3h-5"/></symbol>
<symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/></symbol>
<symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
</defs></svg>
<a class="wd-skip" href="#workspace-main">Skip to workspace</a>
<form runat="server" id="workspaceForm">
<div class="wd-shell">
    <aside class="wd-sidebar" id="workspace-navigation" aria-label="Workspace navigation">
        <a class="wd-brand" href="<%= ResolveUrl("~/") %>" aria-label="PSUT homepage"><img src="<%= ResolveUrl("~/Assets/psut-logo.jpg") %>" alt="PSUT" /></a>
        <span class="wd-sidebar-label">Your portal</span>
        <nav class="wd-side-nav">
            <a href="#overview" class="is-active" data-view="overview" aria-current="page"><svg><use href="#i-grid"/></svg><span>Overview</span></a>
            <a href="#workspace" data-view="workspace"><svg><use href="#i-bag"/></svg><span><%: WorkLabel %></span></a>
            <a href="#activity" data-view="activity"><svg><use href="#i-clock"/></svg><span>Activity</span></a>
            <a href="#reports" data-view="reports"><svg><use href="#i-chart"/></svg><span>Reports</span></a>
        </nav>
        <div class="wd-sidebar-bottom">
            <div class="wd-help-box"><svg><use href="#i-help"/></svg><p>A little guidance<br>goes a long way.</p><a href="mailto:info@psut.edu.jo">Contact PSUT <svg><use href="#i-arrow"/></svg></a></div>
            <a class="wd-home-link" href="<%= ResolveUrl("~/") %>"><svg><use href="#i-home"/></svg>Back to homepage</a>
        </div>
    </aside>
    <div class="wd-page">
        <header class="wd-topbar">
            <button class="wd-icon-button wd-menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="workspace-navigation" aria-expanded="false"><svg><use href="#i-menu"/></svg></button>
            <nav class="wd-tabs" aria-label="Dashboard sections">
                <a href="#overview" data-view="overview" class="is-active" aria-current="page">Overview</a>
                <a href="#workspace" data-view="workspace"><%: WorkLabel %></a>
                <a href="#activity" data-view="activity">Activity</a>
                <a href="#reports" data-view="reports">Reports</a>
            </nav>
            <div class="wd-top-actions">
                <button type="button" class="wd-icon-button" data-refresh aria-label="Refresh workspace"><svg><use href="#i-refresh"/></svg></button>
                <details class="wd-account"><summary><span class="wd-avatar"><%: Initials %></span><span><strong><%: Name %></strong><small><%: RoleName %></small></span></summary><div class="wd-account-menu"><span>Signed in as <%: RoleName %></span><% if (Role == "student") { %><a href="<%= ResolveUrl("~/Student/StudentProfile.aspx") %>">Student profile</a><% } %><a href="<%= ResolveUrl("~/Logout.aspx") %>">Sign out</a></div></details>
            </div>
        </header>
        <main id="workspace-main" class="wd-main" tabindex="-1">
            <div class="wd-heading"><div><h1><%: Heading %></h1><p><%: Description %></p></div><span class="wd-date"><svg><use href="#i-clock"/></svg><%: DateLabel %></span></div>
            <% foreach (string notice in Notices) { %><p class="wd-notice" role="status"><svg><use href="#i-help"/></svg><%: notice %></p><% } %>
            <section data-panel="overview" id="overview" aria-label="Workspace overview">
                <div class="wd-overview-grid">
                    <article class="wd-feature"><div class="wd-feature-copy"><h2><%: FocusTitle %></h2><p><%: FocusText %></p><a class="wd-button wd-button-light" href="<%: PrimaryUrl %>"><%: PrimaryLabel %><svg><use href="#i-arrow"/></svg></a></div><img src="<%= ResolveUrl("~/Assets/psut-rooftop.jpg") %>" alt="The PSUT campus and Amman skyline" /><span class="wd-feature-caption">Experience begins with you.</span></article>
                    <article class="wd-status-panel"><div class="wd-panel-heading"><h2>Placement overview</h2><svg><use href="#i-chart"/></svg></div><p>Application decisions at a glance</p><div class="wd-status-chart" role="img" aria-label="<%: ApplicationsAvailable ? PendingCount + " pending, " + ApprovedCount + " approved, " + RejectedCount + " rejected applications" : "Application data unavailable" %>">
                        <% var total = Math.Max(1, PendingCount + ApprovedCount + RejectedCount); %>
                        <div class="wd-chart-bar wd-chart-pending" style="flex-grow:<%= PendingCount %>"></div><div class="wd-chart-bar wd-chart-approved" style="flex-grow:<%= ApprovedCount %>"></div><div class="wd-chart-bar wd-chart-rejected" style="flex-grow:<%= RejectedCount %>"></div>
                        <% if (PendingCount + ApprovedCount + RejectedCount == 0) { %><div class="wd-chart-empty"></div><% } %>
                    </div><ul class="wd-legend"><li><i class="wd-dot pending"></i>Pending<strong><%: ApplicationsAvailable ? PendingCount.ToString() : "—" %></strong></li><li><i class="wd-dot approved"></i>Approved<strong><%: ApplicationsAvailable ? ApprovedCount.ToString() : "—" %></strong></li><li><i class="wd-dot rejected"></i>Rejected<strong><%: ApplicationsAvailable ? RejectedCount.ToString() : "—" %></strong></li></ul><span class="wd-data-caption"><%: ApplicationsAvailable ? "From your current application records" : "Waiting for application access" %></span></article>
                </div>
                <div class="wd-metrics"><% foreach (var metric in Metrics) { %><article><span><%: metric.Label %></span><strong><%: metric.Value %></strong><p><%: metric.Hint %></p></article><% } %></div>
                <div class="wd-section-heading"><div><h2>Make your next move.</h2><p>A clear path from ambition to experience.</p></div><span class="wd-drag-label">Drag to explore <svg><use href="#i-arrow"/></svg></span></div>
                <div class="wd-action-rail" tabindex="0" role="region" aria-label="Workspace quick actions" data-drag-rail>
                    <% if (Role == "student") { %>
                    <a class="wd-action-tile" href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>"><svg><use href="#i-bag"/></svg><h3>Find your placement.</h3><p>Explore open internships and find where your skills can grow.</p><span>Browse opportunities <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile" href="<%= ResolveUrl("~/Student/MyApplications.aspx") %>"><svg><use href="#i-clock"/></svg><h3>Keep things moving.</h3><p>Follow decisions, review offers and confirm your internship.</p><span>My applications <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile wd-action-photo" href="<%= ResolveUrl("~/Student/StudentProfile.aspx") %>"><img src="<%= ResolveUrl("~/Assets/psut-walkway.jpg") %>" alt=""/><h3>Your story.<br>Your potential.</h3><span>View student profile <svg><use href="#i-arrow"/></svg></span></a>
                    <% } else { %>
                    <a class="wd-action-tile" href="#workspace" data-view="workspace"><svg><use href="#i-user"/></svg><h3><%: Role == "company" ? "Discover your talent." : "People come first." %></h3><p><%: Role == "company" ? "See the opportunities connected to your company." : "Keep the students connected to your workspace in view." %></p><span><%: WorkLabel %> <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile" href="#activity" data-view="activity"><svg><use href="#i-clock"/></svg><h3>Stay connected.</h3><p>Follow placement decisions and see what needs attention.</p><span>View activity <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile wd-action-photo" href="#reports" data-view="reports"><img src="<%= ResolveUrl("~/Assets/psut-students.jpeg") %>" alt=""/><h3>See the<br>bigger picture.</h3><span>Workspace reports <svg><use href="#i-arrow"/></svg></span></a>
                    <% } %>
                </div>
            </section>
            <section data-panel="workspace" id="workspace" hidden aria-labelledby="work-title"><div class="wd-section-heading"><div><h2 id="work-title"><%: WorkLabel %></h2><p><%: Role == "student" ? "Review your submitted applications and respond to offers." : Role == "company" ? "Opportunities published under your company account." : "People connected to your supervision workspace." %></p></div><% if (Role == "student") { %><a class="wd-button" href="<%= ResolveUrl("~/Student/MyApplications.aspx") %>">Manage applications<svg><use href="#i-arrow"/></svg></a><% } %></div>
                <% if (Role == "company") { %><div class="wd-opening-grid"><% foreach (var opening in Openings) { %><article class="wd-opening"><span class="wd-badge"><%: opening.Status %></span><h3><%: opening.Title %></h3><p><%: opening.Location %> · <%: opening.Mode %></p><span>Deadline: <%: opening.Deadline %></span></article><% } %></div><% if (Openings.Count == 0) { %><div class="wd-empty"><svg><use href="#i-bag"/></svg><h3>No company opportunities to show</h3><p>Opportunities linked to your company account will appear here.</p></div><% } %><% } %>
                <% if (Role == "academic" || Role == "admin") { %><div class="wd-people-grid"><% foreach (var person in People) { %><article class="wd-person"><span class="wd-avatar"><svg><use href="#i-user"/></svg></span><div><h3><%: person.Title %></h3><p><%: person.Person %></p></div><span class="wd-badge"><%: person.Status %></span></article><% } %></div><% if (People.Count == 0) { %><div class="wd-empty"><svg><use href="#i-user"/></svg><h3>No student records to show</h3><p><%: Role == "academic" ? "Students assigned to your academic supervisor account will appear here." : "Student accounts will appear here when they are available to your coordinator account." %></p></div><% } %><% } %>
            </section>
            <section data-panel="reports" id="reports" hidden aria-labelledby="report-title"><div class="wd-section-heading"><div><h2 id="report-title">Your workspace, in perspective.</h2><p>Export the application records available to your account.</p></div><button class="wd-button" type="button" data-export <%= Rows.Count == 0 ? "disabled" : "" %>>Download CSV<svg><use href="#i-download"/></svg></button></div><div class="wd-report-note"><h3>Application summary</h3><p><%: ApplicationsAvailable ? "This report includes the application titles, students or organizations, decisions and submission dates shown below." : "Application records are unavailable under the current database permissions. An export will become available when records can be read." %></p><p>Exports reflect the records loaded when you opened this page. Refresh to include recent changes.</p></div></section>
            <section class="wd-activity-panel" id="activity" aria-labelledby="activity-title"><div class="wd-table-toolbar"><div><h2 id="activity-title"><%: ActivityLabel %></h2><p>Every application. A step forward.</p></div><div class="wd-table-actions"><label class="wd-search"><svg><use href="#i-search"/></svg><input type="search" id="activitySearch" placeholder="Search activity" aria-label="Search application activity" /></label><select id="activityStatus" aria-label="Filter by application status"><option value="all">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div></div>
                <div class="wd-table-scroll"><table id="activityTable"><thead><tr><th scope="col">Opportunity</th><th scope="col"><%: Role == "student" ? "Organization" : "Student" %></th><th scope="col">Status</th><th scope="col">Applied on</th><% if (Role == "student") { %><th scope="col"><span class="wd-sr-only">Actions</span></th><% } %></tr></thead><tbody><% foreach (var row in Rows) { %><tr data-status="<%: row.Status %>"><td><span class="wd-row-icon"><svg><use href="#i-bag"/></svg></span><strong><%: string.IsNullOrWhiteSpace(row.Title) ? "Internship application" : row.Title %></strong></td><td><%: string.IsNullOrWhiteSpace(row.Person) ? "Not provided" : row.Person %></td><td><span class="wd-badge <%: row.Status.ToLowerInvariant() %>"><%: row.Status %></span></td><td><%: row.Date %></td><% if (Role == "student") { %><td><a class="wd-row-link" href="<%: row.Url %>" aria-label="Review application for <%: row.Title %>"><svg><use href="#i-arrow"/></svg></a></td><% } %></tr><% } %></tbody></table></div>
                <% if (Rows.Count == 0) { %><div class="wd-empty"><svg><use href="#i-bag"/></svg><h3><%: EmptyTitle %></h3><p><%: EmptyDescription %></p><% if (Role == "student") { %><a href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>" class="wd-text-link">Explore opportunities <svg><use href="#i-arrow"/></svg></a><% } %></div><% } %>
                <p class="wd-filter-empty" hidden>No applications match your search. Try another name or status.</p><p class="wd-table-count" role="status" aria-live="polite"><span id="visibleCount"><%: Rows.Count %></span> records in this workspace</p>
            </section>
            <section class="wd-recommendations" data-student-openings <%= Role != "student" ? "hidden" : "" %>><div class="wd-section-heading"><div><h2>Room to grow.</h2><p>Open opportunities from the portal.</p></div><a class="wd-text-link" href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>">View all <svg><use href="#i-arrow"/></svg></a></div><div class="wd-opening-grid"><% foreach (var opening in Openings.Take(3)) { %><a class="wd-opening" href="<%: opening.Url %>"><span class="wd-badge approved">Open</span><h3><%: opening.Title %></h3><p><%: opening.Location %> · <%: opening.Mode %></p><span><%: opening.Deadline %><svg><use href="#i-arrow"/></svg></span></a><% } %></div><% if (Role == "student" && Openings.Count == 0) { %><p class="wd-muted">No open opportunities are available right now. Check back for your next chapter.</p><% } %></section>
            <asp:ContentPlaceHolder ID="WorkspaceContent" runat="server" />
            <footer class="wd-footer"><span>PSUT <strong>Internship Portal</strong></span><span>Learning with purpose. Experience that matters.</span></footer>
        </main>
    </div>
</div>
</form>
<div class="wd-toast" role="status" aria-live="polite" hidden></div>
<script src="<%= ResolveUrl("~/Scripts/interactions.js") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/workspace.js") %>"></script>
</body>
</html>

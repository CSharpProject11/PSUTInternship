<%@ Import Namespace="PSUTInternship.Models" %>
<%@ Master Language="C#" MasterPageFile="~/Portal.Master" AutoEventWireup="true" CodeBehind="Workspace.Master.cs" Inherits="PSUTInternship.WorkspaceLayout" %>
<%@ Register Src="~/Shared/StudentNav.ascx" TagPrefix="psut" TagName="StudentNav" %>
<asp:Content ID="DashboardHead" ContentPlaceHolderID="PortalHead" runat="server"><link rel="stylesheet" href="<%= ResolveUrl("~/Content/workspace.css") %>" /><% if (Role == "admin") { %>
<style>
/* Coordinator operations view. Keep the shared PSUT shell and live data. */
.portal-content .coordinator-dashboard{--co-ink:#17364d;--co-muted:#5d7385;--co-line:#dce6ed;max-width:1240px;margin:0 auto;font-family:Manrope,Arial,sans-serif}
.portal-content .coordinator-dashboard .wd-heading{display:flex;justify-content:space-between;gap:24px;align-items:center;margin:0 0 28px;padding:0;border:0}.portal-content .coordinator-dashboard .wd-heading h1{font-size:29px!important;font-weight:750;letter-spacing:-.035em;line-height:1.3;margin:0 0 8px!important;color:var(--co-ink)}.portal-content .coordinator-dashboard .wd-heading p{font-size:13px!important;color:var(--co-muted);line-height:1.7}.portal-content .coordinator-dashboard .wd-date{font-size:12px!important;background:#fff;border:1px solid var(--co-line);padding:9px 12px;border-radius:8px;color:var(--co-muted)}
.portal-content .coordinator-dashboard .wd-metrics{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));gap:0!important;background:#fff;border:1px solid var(--co-line);border-radius:14px;overflow:hidden;margin-bottom:24px}.portal-content .coordinator-dashboard .wd-metrics article{padding:22px 24px!important;border:0!important;border-radius:0!important;border-right:1px solid var(--co-line)!important;box-shadow:none!important;background:#fff!important}.portal-content .coordinator-dashboard .wd-metrics article:last-child{border-right:0!important}.portal-content .coordinator-dashboard .wd-metrics span{font-size:12px!important;color:var(--co-muted)}.portal-content .coordinator-dashboard .wd-metrics strong{font-size:32px!important;font-weight:650!important;line-height:1.3;letter-spacing:-.035em;color:var(--co-ink);margin:9px 0 5px;font-variant-numeric:tabular-nums}.portal-content .coordinator-dashboard .wd-metrics p{font-size:11px!important;line-height:1.65;color:var(--co-muted);margin:0}
.portal-content .coordinator-dashboard .wd-overview-grid{display:grid;grid-template-columns:1fr;gap:0;margin:0 0 28px}.portal-content .coordinator-dashboard .wd-feature{display:none!important}.portal-content .coordinator-dashboard .wd-status-panel{display:grid;grid-template-columns:1fr 1.5fr;gap:8px 36px;background:#fff!important;border:1px solid var(--co-line)!important;border-radius:14px!important;padding:24px!important;box-shadow:none!important}.portal-content .coordinator-dashboard .wd-panel-heading{grid-column:1;grid-row:1;margin:0!important}.portal-content .coordinator-dashboard .wd-panel-heading h2{font-size:17px!important;letter-spacing:-.02em}.portal-content .coordinator-dashboard .wd-panel-heading>svg{display:none}.portal-content .coordinator-dashboard .wd-status-panel>p{grid-column:1;grid-row:2;font-size:12px!important;color:var(--co-muted);margin:0}.portal-content .coordinator-dashboard .wd-status-chart{grid-column:2;grid-row:1;height:10px!important;margin:6px 0 0!important}.portal-content .coordinator-dashboard .wd-legend{grid-column:2;grid-row:2;display:flex!important;justify-content:space-between;gap:18px;margin:8px 0 0!important}.portal-content .coordinator-dashboard .wd-legend li{font-size:12px!important;display:flex;align-items:center;gap:8px}.portal-content .coordinator-dashboard .wd-legend strong{margin-left:8px;font-variant-numeric:tabular-nums}.portal-content .coordinator-dashboard .wd-data-caption{grid-column:1/-1;font-size:11px!important;color:var(--co-muted);margin-top:8px}
.portal-content .coordinator-dashboard .wd-action-rail,.portal-content .coordinator-dashboard .wd-drag-label{display:none!important}.portal-content .coordinator-dashboard .wd-section-heading{margin-bottom:16px}.portal-content .coordinator-dashboard .wd-section-heading h2{font-size:18px!important}.portal-content .coordinator-dashboard .wd-section-heading p{font-size:12px!important;color:var(--co-muted)}
.coordinator-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;background:#fff;border:1px solid var(--co-line);border-radius:14px;padding:4px 24px;margin-bottom:28px}.coordinator-links a{display:grid;grid-template-columns:1fr 20px;gap:4px 20px;padding:18px 0;text-decoration:none;border-bottom:1px solid #e8eef3;color:var(--co-ink)}.coordinator-links a:nth-last-child(-n+2){border-bottom:0}.coordinator-links strong{font-size:14px;font-weight:650}.coordinator-links small{grid-column:1;font-size:12px;line-height:1.7;color:var(--co-muted)}.coordinator-links svg{grid-column:2;grid-row:1/3;align-self:center;width:18px;height:18px;fill:none;stroke:#50748f;stroke-width:1.5;transition:transform .15s}.coordinator-links a:hover strong{color:#0078b5}.coordinator-links a:hover svg{transform:translateX(3px)}
.portal-content .coordinator-dashboard .wd-activity-panel{background:#fff!important;border:1px solid var(--co-line)!important;border-radius:14px!important;box-shadow:none!important;overflow:hidden;padding:0!important}.portal-content .coordinator-dashboard .wd-table-toolbar{padding:24px!important;gap:16px;flex-wrap:wrap}.portal-content .coordinator-dashboard .wd-table-toolbar h2{font-size:18px!important}.portal-content .coordinator-dashboard .wd-table-toolbar p{font-size:12px!important;color:var(--co-muted)}.portal-content .coordinator-dashboard th{font-size:11px!important;background:#f5f8fa!important;color:var(--co-muted)!important;padding:12px 20px!important}.portal-content .coordinator-dashboard td{font-size:13px!important;padding:16px 20px!important;border-color:#e8eef3!important}.portal-content .coordinator-dashboard td strong{font-weight:550!important}.portal-content .coordinator-dashboard .wd-row-icon{display:none}.portal-content .coordinator-dashboard .wd-search input{font-size:12px!important}.portal-content .coordinator-dashboard .wd-table-actions select{font-size:12px!important}.portal-content .coordinator-dashboard .wd-empty{padding:30px!important}.portal-content .coordinator-dashboard .wd-empty svg{display:none}.portal-content .coordinator-dashboard .wd-empty h3{font-size:16px!important}.portal-content .coordinator-dashboard .wd-empty p{font-size:12px!important;line-height:1.8;max-width:55ch;margin:auto}.portal-content .coordinator-dashboard .wd-table-count{font-size:11px!important;padding:16px 24px!important}.coordinator-dashboard :focus-visible{outline:3px solid #0078b5;outline-offset:4px}.coordinator-dashboard ::selection{background:#c8e6f3;color:#17364d}
@media(max-width:950px){.portal-content .coordinator-dashboard .wd-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.portal-content .coordinator-dashboard .wd-status-panel{grid-template-columns:1fr}.portal-content .coordinator-dashboard .wd-status-panel>*{grid-column:1!important;grid-row:auto!important}.portal-content .coordinator-dashboard .wd-status-chart{margin-top:12px!important}}@media(max-width:600px){.portal-content .coordinator-dashboard .wd-heading{align-items:flex-start;flex-direction:column;gap:12px}.portal-content .coordinator-dashboard .wd-heading h1{font-size:25px!important}.portal-content .coordinator-dashboard .wd-metrics article{padding:18px!important}.coordinator-links{grid-template-columns:1fr;padding:0 18px}.coordinator-links a:nth-last-child(2){border-bottom:1px solid #e8eef3}.portal-content .coordinator-dashboard .wd-legend{flex-wrap:wrap}.portal-content .coordinator-dashboard .wd-table-actions{flex-wrap:wrap;width:100%}.portal-content .coordinator-dashboard .wd-table-toolbar{padding:18px!important}}@media(prefers-reduced-motion:reduce){.coordinator-links svg{transition:none}}
/* Explicit state selectors defeat legacy first-metric emphasis and inherited spacing. */
body.portal-app .portal-content .coordinator-dashboard .wd-heading{margin:0 0 22px!important;padding:0!important;align-items:center!important}
body.portal-app .portal-content .coordinator-dashboard .wd-heading h1{font-size:26px!important;font-weight:700!important;letter-spacing:-.025em!important;line-height:1.3!important;margin:0 0 6px!important}
body.portal-app .portal-content .coordinator-dashboard .wd-heading p{font-size:12px!important;font-weight:400!important;line-height:1.7!important;margin:0!important;color:#607587!important}
body.portal-app .portal-content .coordinator-dashboard .wd-date{background:transparent!important;border:0!important;padding:0!important;font-size:11px!important;font-weight:500!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics{padding:0!important;margin:0 0 22px!important;background:#fff!important;gap:0!important;border:1px solid #dce6ed!important;border-radius:12px!important;box-shadow:none!important;align-items:stretch!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article,
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article:first-child{background:#fff!important;padding:20px 22px!important;border:0!important;border-right:1px solid #e2e9ef!important;box-shadow:none!important;border-radius:0!important;min-height:0!important;color:#17364d!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article:last-child{border-right:0!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article>span,
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article:first-child>span{font-size:12px!important;font-weight:500!important;color:#607587!important;line-height:1.5!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article strong,
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article:first-child strong{font-size:30px!important;font-weight:600!important;line-height:1.25!important;letter-spacing:-.035em!important;color:#17364d!important;margin:10px 0 7px!important}
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article p,
body.portal-app .portal-content .coordinator-dashboard .wd-metrics article:first-child p{font-size:11px!important;font-weight:400!important;line-height:1.6!important;color:#607587!important;margin:0!important}
@media(max-width:600px){body.portal-app .portal-content .coordinator-dashboard .wd-metrics article{padding:16px!important}body.portal-app .portal-content .coordinator-dashboard .wd-heading{align-items:flex-start!important}body.portal-app .portal-content .coordinator-dashboard .wd-heading h1{font-size:23px!important}}
</style>
<% } %><% if (Role == "student") { %><style>
body.portal-app[data-role=student] .role-dashboard{--st-ink:#17364d;--st-muted:#607587;--st-line:#dce6ed;max-width:1240px;margin:auto}
body.portal-app[data-role=student] .role-dashboard .wd-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 24px!important}.portal-app[data-role=student] .role-dashboard .wd-heading h1{font-size:28px!important;letter-spacing:-.03em!important;margin:0 0 8px!important;font-weight:700!important}.portal-app[data-role=student] .role-dashboard .wd-heading p{font-size:13px!important;font-weight:400!important;line-height:1.7;color:var(--st-muted)}.portal-app[data-role=student] .role-dashboard .wd-date{font-size:11px!important;background:none;border:0;color:var(--st-muted)}
body.portal-app[data-role=student] .role-dashboard .wd-metrics{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));padding:0!important;gap:0!important;margin:0 0 24px!important;background:#fff!important;border:1px solid var(--st-line)!important;border-radius:12px!important;overflow:hidden}
body.portal-app[data-role=student] .role-dashboard .wd-metrics article,body.portal-app[data-role=student] .role-dashboard .wd-metrics article:first-child{background:#fff!important;padding:20px!important;border:0!important;border-right:1px solid var(--st-line)!important;border-radius:0!important;box-shadow:none!important;min-height:0!important}.portal-app[data-role=student] .role-dashboard .wd-metrics article:last-child{border-right:0!important}body.portal-app[data-role=student] .role-dashboard .wd-metrics article>span{font-size:12px!important;color:var(--st-muted)!important;font-weight:500!important}body.portal-app[data-role=student] .role-dashboard .wd-metrics article strong{font-size:30px!important;font-weight:600!important;color:var(--st-ink)!important;line-height:1.3;letter-spacing:-.03em;margin:9px 0!important;font-variant-numeric:tabular-nums}body.portal-app[data-role=student] .role-dashboard .wd-metrics article p{font-size:11px!important;font-weight:400!important;color:var(--st-muted)!important;line-height:1.7;margin:0!important}
.portal-app[data-role=student] .role-dashboard .wd-overview-grid{grid-template-columns:1.3fr 1fr;gap:20px;margin-bottom:28px}.portal-app[data-role=student] .role-dashboard .wd-feature{background:#e6f1f7!important;border:0!important;border-radius:14px!important;min-height:0!important;overflow:hidden}.portal-app[data-role=student] .role-dashboard .wd-feature::before,.portal-app[data-role=student] .role-dashboard .wd-feature::after{display:none!important}.portal-app[data-role=student] .role-dashboard .wd-feature-copy{width:100%!important;padding:28px!important}.portal-app[data-role=student] .role-dashboard .wd-feature h2{font-size:25px!important;letter-spacing:-.03em;line-height:1.3;color:#003e73!important;max-width:25ch;margin:0 0 12px!important}.portal-app[data-role=student] .role-dashboard .wd-feature p{font-size:13px!important;color:#486b82!important;font-weight:400!important;line-height:1.8;max-width:48ch}.portal-app[data-role=student] .role-dashboard .wd-feature .wd-button{background:#003e73!important;color:white!important;font-size:12px!important;border-radius:6px!important;padding:11px 16px!important;min-height:40px!important;margin-top:12px}
.portal-app[data-role=student] .role-dashboard .wd-status-panel{padding:24px!important;background:#fff!important;border:1px solid var(--st-line)!important;border-radius:14px!important;box-shadow:none!important}.portal-app[data-role=student] .role-dashboard .wd-status-panel h2{font-size:16px!important}.portal-app[data-role=student] .role-dashboard .wd-status-panel>p{font-size:12px!important;color:var(--st-muted)}.portal-app[data-role=student] .role-dashboard .wd-status-chart{height:9px!important;margin:22px 0!important}.portal-app[data-role=student] .role-dashboard .wd-legend li{font-size:12px!important}.portal-app[data-role=student] .role-dashboard .wd-data-caption{font-size:11px!important}
.portal-app[data-role=student] .role-dashboard .wd-section-heading{margin:26px 0 14px!important}.portal-app[data-role=student] .role-dashboard .wd-section-heading h2{font-size:18px!important}.portal-app[data-role=student] .role-dashboard .wd-section-heading p{font-size:12px!important}.portal-app[data-role=student] .role-dashboard .wd-drag-label{display:none!important}.portal-app[data-role=student] .role-dashboard .wd-action-rail{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;overflow:visible!important;cursor:auto!important;margin-bottom:28px}.portal-app[data-role=student] .role-dashboard .wd-action-tile{min-width:0!important;min-height:0!important;padding:20px!important;border:1px solid var(--st-line)!important;border-radius:12px!important;background:#fff!important;box-shadow:none!important;color:var(--st-ink)!important}.portal-app[data-role=student] .role-dashboard .wd-action-tile::before,.portal-app[data-role=student] .role-dashboard .wd-action-tile::after,.portal-app[data-role=student] .role-dashboard .wd-action-tile>svg{display:none!important}.portal-app[data-role=student] .role-dashboard .wd-action-tile h3{font-size:15px!important;line-height:1.5!important;color:var(--st-ink)!important;margin:0 0 7px!important}.portal-app[data-role=student] .role-dashboard .wd-action-tile p{font-size:12px!important;color:var(--st-muted)!important;font-weight:400!important;line-height:1.8;margin:0 0 16px!important}.portal-app[data-role=student] .role-dashboard .wd-action-tile>span{font-size:12px!important;color:#003e73!important;margin-top:12px!important}.portal-app[data-role=student] .role-dashboard .wd-action-tile:hover{border-color:#78a5c1!important}
.portal-app[data-role=student] .role-dashboard .wd-activity-panel{background:#fff!important;border:1px solid var(--st-line)!important;border-radius:14px!important;box-shadow:none!important;overflow:hidden}.portal-app[data-role=student] .role-dashboard .wd-table-toolbar{padding:22px!important;gap:16px;flex-wrap:wrap}.portal-app[data-role=student] .role-dashboard .wd-table-toolbar h2{font-size:18px!important}.portal-app[data-role=student] .role-dashboard .wd-table-toolbar p{font-size:12px!important}.portal-app[data-role=student] .role-dashboard th{font-size:11px!important;background:#f5f8fa!important;padding:12px 18px!important}.portal-app[data-role=student] .role-dashboard td{font-size:13px!important;padding:15px 18px!important}.portal-app[data-role=student] .role-dashboard .wd-table-count{font-size:11px!important;padding:16px 22px!important}.portal-app[data-role=student] .role-dashboard .wd-empty h3{font-size:16px!important}.portal-app[data-role=student] .role-dashboard .wd-empty p{font-size:12px!important;line-height:1.8}.portal-app[data-role=student] .role-dashboard .wd-opening{background:#fff!important;border:1px solid var(--st-line)!important;border-radius:12px!important;padding:20px!important;box-shadow:none!important}.portal-app[data-role=student] .role-dashboard .wd-opening h3{font-size:15px!important}.portal-app[data-role=student] .role-dashboard .wd-opening p{font-size:12px!important}.role-dashboard :focus-visible{outline:3px solid #0078b5;outline-offset:3px}
@media(max-width:950px){.portal-app[data-role=student] .role-dashboard .wd-overview-grid{grid-template-columns:1fr}body.portal-app[data-role=student] .role-dashboard .wd-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.portal-app[data-role=student] .role-dashboard .wd-heading{flex-direction:column;align-items:flex-start!important}.portal-app[data-role=student] .role-dashboard .wd-action-rail{grid-template-columns:1fr}.portal-app[data-role=student] .role-dashboard .wd-feature-copy{padding:22px!important}.portal-app[data-role=student] .role-dashboard .wd-table-actions{flex-wrap:wrap;width:100%}}
</style><% } %><% if (Role == "company") { %><style>
/* Coordinator operations view. Keep the shared PSUT shell and live data. */
.portal-content .company-dashboard{--co-ink:#17364d;--co-muted:#5d7385;--co-line:#dce6ed;max-width:1240px;margin:0 auto;font-family:Manrope,Arial,sans-serif}
.portal-content .company-dashboard .wd-heading{display:flex;justify-content:space-between;gap:24px;align-items:center;margin:0 0 28px;padding:0;border:0}.portal-content .company-dashboard .wd-heading h1{font-size:29px!important;font-weight:750;letter-spacing:-.035em;line-height:1.3;margin:0 0 8px!important;color:var(--co-ink)}.portal-content .company-dashboard .wd-heading p{font-size:13px!important;color:var(--co-muted);line-height:1.7}.portal-content .company-dashboard .wd-date{font-size:12px!important;background:#fff;border:1px solid var(--co-line);padding:9px 12px;border-radius:8px;color:var(--co-muted)}
.portal-content .company-dashboard .wd-metrics{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));gap:0!important;background:#fff;border:1px solid var(--co-line);border-radius:14px;overflow:hidden;margin-bottom:24px}.portal-content .company-dashboard .wd-metrics article{padding:22px 24px!important;border:0!important;border-radius:0!important;border-right:1px solid var(--co-line)!important;box-shadow:none!important;background:#fff!important}.portal-content .company-dashboard .wd-metrics article:last-child{border-right:0!important}.portal-content .company-dashboard .wd-metrics span{font-size:12px!important;color:var(--co-muted)}.portal-content .company-dashboard .wd-metrics strong{font-size:32px!important;font-weight:650!important;line-height:1.3;letter-spacing:-.035em;color:var(--co-ink);margin:9px 0 5px;font-variant-numeric:tabular-nums}.portal-content .company-dashboard .wd-metrics p{font-size:11px!important;line-height:1.65;color:var(--co-muted);margin:0}
.portal-content .company-dashboard .wd-overview-grid{display:grid;grid-template-columns:1fr;gap:0;margin:0 0 28px}.portal-content .company-dashboard .wd-feature{display:none!important}.portal-content .company-dashboard .wd-status-panel{display:grid;grid-template-columns:1fr 1.5fr;gap:8px 36px;background:#fff!important;border:1px solid var(--co-line)!important;border-radius:14px!important;padding:24px!important;box-shadow:none!important}.portal-content .company-dashboard .wd-panel-heading{grid-column:1;grid-row:1;margin:0!important}.portal-content .company-dashboard .wd-panel-heading h2{font-size:17px!important;letter-spacing:-.02em}.portal-content .company-dashboard .wd-panel-heading>svg{display:none}.portal-content .company-dashboard .wd-status-panel>p{grid-column:1;grid-row:2;font-size:12px!important;color:var(--co-muted);margin:0}.portal-content .company-dashboard .wd-status-chart{grid-column:2;grid-row:1;height:10px!important;margin:6px 0 0!important}.portal-content .company-dashboard .wd-legend{grid-column:2;grid-row:2;display:flex!important;justify-content:space-between;gap:18px;margin:8px 0 0!important}.portal-content .company-dashboard .wd-legend li{font-size:12px!important;display:flex;align-items:center;gap:8px}.portal-content .company-dashboard .wd-legend strong{margin-left:8px;font-variant-numeric:tabular-nums}.portal-content .company-dashboard .wd-data-caption{grid-column:1/-1;font-size:11px!important;color:var(--co-muted);margin-top:8px}
.portal-content .company-dashboard .wd-action-rail,.portal-content .company-dashboard .wd-drag-label{display:none!important}.portal-content .company-dashboard .wd-section-heading{margin-bottom:16px}.portal-content .company-dashboard .wd-section-heading h2{font-size:18px!important}.portal-content .company-dashboard .wd-section-heading p{font-size:12px!important;color:var(--co-muted)}
.company-dashboard-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;background:#fff;border:1px solid var(--co-line);border-radius:14px;padding:4px 24px;margin-bottom:28px}.company-dashboard-links a{display:grid;grid-template-columns:1fr 20px;gap:4px 20px;padding:18px 0;text-decoration:none;border-bottom:1px solid #e8eef3;color:var(--co-ink)}.company-dashboard-links a:nth-last-child(-n+2){border-bottom:0}.company-dashboard-links strong{font-size:14px;font-weight:650}.company-dashboard-links small{grid-column:1;font-size:12px;line-height:1.7;color:var(--co-muted)}.company-dashboard-links svg{grid-column:2;grid-row:1/3;align-self:center;width:18px;height:18px;fill:none;stroke:#50748f;stroke-width:1.5;transition:transform .15s}.company-dashboard-links a:hover strong{color:#0078b5}.company-dashboard-links a:hover svg{transform:translateX(3px)}
.portal-content .company-dashboard .wd-activity-panel{background:#fff!important;border:1px solid var(--co-line)!important;border-radius:14px!important;box-shadow:none!important;overflow:hidden;padding:0!important}.portal-content .company-dashboard .wd-table-toolbar{padding:24px!important;gap:16px;flex-wrap:wrap}.portal-content .company-dashboard .wd-table-toolbar h2{font-size:18px!important}.portal-content .company-dashboard .wd-table-toolbar p{font-size:12px!important;color:var(--co-muted)}.portal-content .company-dashboard th{font-size:11px!important;background:#f5f8fa!important;color:var(--co-muted)!important;padding:12px 20px!important}.portal-content .company-dashboard td{font-size:13px!important;padding:16px 20px!important;border-color:#e8eef3!important}.portal-content .company-dashboard td strong{font-weight:550!important}.portal-content .company-dashboard .wd-row-icon{display:none}.portal-content .company-dashboard .wd-search input{font-size:12px!important}.portal-content .company-dashboard .wd-table-actions select{font-size:12px!important}.portal-content .company-dashboard .wd-empty{padding:30px!important}.portal-content .company-dashboard .wd-empty svg{display:none}.portal-content .company-dashboard .wd-empty h3{font-size:16px!important}.portal-content .company-dashboard .wd-empty p{font-size:12px!important;line-height:1.8;max-width:55ch;margin:auto}.portal-content .company-dashboard .wd-table-count{font-size:11px!important;padding:16px 24px!important}.company-dashboard :focus-visible{outline:3px solid #0078b5;outline-offset:4px}.company-dashboard ::selection{background:#c8e6f3;color:#17364d}
@media(max-width:950px){.portal-content .company-dashboard .wd-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.portal-content .company-dashboard .wd-status-panel{grid-template-columns:1fr}.portal-content .company-dashboard .wd-status-panel>*{grid-column:1!important;grid-row:auto!important}.portal-content .company-dashboard .wd-status-chart{margin-top:12px!important}}@media(max-width:600px){.portal-content .company-dashboard .wd-heading{align-items:flex-start;flex-direction:column;gap:12px}.portal-content .company-dashboard .wd-heading h1{font-size:25px!important}.portal-content .company-dashboard .wd-metrics article{padding:18px!important}.company-dashboard-links{grid-template-columns:1fr;padding:0 18px}.company-dashboard-links a:nth-last-child(2){border-bottom:1px solid #e8eef3}.portal-content .company-dashboard .wd-legend{flex-wrap:wrap}.portal-content .company-dashboard .wd-table-actions{flex-wrap:wrap;width:100%}.portal-content .company-dashboard .wd-table-toolbar{padding:18px!important}}@media(prefers-reduced-motion:reduce){.company-dashboard-links svg{transition:none}}
/* Explicit state selectors defeat legacy first-metric emphasis and inherited spacing. */
body.portal-app .portal-content .company-dashboard .wd-heading{margin:0 0 22px!important;padding:0!important;align-items:center!important}
body.portal-app .portal-content .company-dashboard .wd-heading h1{font-size:26px!important;font-weight:700!important;letter-spacing:-.025em!important;line-height:1.3!important;margin:0 0 6px!important}
body.portal-app .portal-content .company-dashboard .wd-heading p{font-size:12px!important;font-weight:400!important;line-height:1.7!important;margin:0!important;color:#607587!important}
body.portal-app .portal-content .company-dashboard .wd-date{background:transparent!important;border:0!important;padding:0!important;font-size:11px!important;font-weight:500!important}
body.portal-app .portal-content .company-dashboard .wd-metrics{padding:0!important;margin:0 0 22px!important;background:#fff!important;gap:0!important;border:1px solid #dce6ed!important;border-radius:12px!important;box-shadow:none!important;align-items:stretch!important}
body.portal-app .portal-content .company-dashboard .wd-metrics article,
body.portal-app .portal-content .company-dashboard .wd-metrics article:first-child{background:#fff!important;padding:20px 22px!important;border:0!important;border-right:1px solid #e2e9ef!important;box-shadow:none!important;border-radius:0!important;min-height:0!important;color:#17364d!important}
body.portal-app .portal-content .company-dashboard .wd-metrics article:last-child{border-right:0!important}
body.portal-app .portal-content .company-dashboard .wd-metrics article>span,
body.portal-app .portal-content .company-dashboard .wd-metrics article:first-child>span{font-size:12px!important;font-weight:500!important;color:#607587!important;line-height:1.5!important}
body.portal-app .portal-content .company-dashboard .wd-metrics article strong,
body.portal-app .portal-content .company-dashboard .wd-metrics article:first-child strong{font-size:30px!important;font-weight:600!important;line-height:1.25!important;letter-spacing:-.035em!important;color:#17364d!important;margin:10px 0 7px!important}
body.portal-app .portal-content .company-dashboard .wd-metrics article p,
body.portal-app .portal-content .company-dashboard .wd-metrics article:first-child p{font-size:11px!important;font-weight:400!important;line-height:1.6!important;color:#607587!important;margin:0!important}
@media(max-width:600px){body.portal-app .portal-content .company-dashboard .wd-metrics article{padding:16px!important}body.portal-app .portal-content .company-dashboard .wd-heading{align-items:flex-start!important}body.portal-app .portal-content .company-dashboard .wd-heading h1{font-size:23px!important}}
</style><% } %></asp:Content>
<asp:Content ID="DashboardBody" ContentPlaceHolderID="PortalContent" runat="server">
<div class="<%= Role == "admin" ? "coordinator-dashboard" : Role == "company" ? "company-dashboard" : "role-dashboard" %>"><svg class="wd-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-bag" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="3"/><path d="M8 7V4h8v3M3 12h18M10 12v3h4v-3"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 4v16h17M8 15v-4m5 4V7m5 8v-6"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
<symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v11H3zM9 21v-8h6v8"/></symbol>
<symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 9a3 3 0 1 1 4 3c-1 .5-1 1-1 2m0 3h.01"/></symbol>
<symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 7V3l-4 4a8 8 0 1 0 3 10M20 3h-5"/></symbol>
<symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/></symbol>
<symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
</defs></svg>
            <div class="wd-heading"><div><h1><%: Heading %></h1><p><%: Description %></p></div><div class="sd-heading-tools"><span class="wd-date"><svg><use href="#i-clock"/></svg><%: DateLabel %></span></div></div>
            <% foreach (string notice in Notices) { %><p class="wd-notice" role="status"><svg><use href="#i-help"/></svg><%: notice %></p><% } %>
            <section data-panel="overview" id="overview" aria-label="Workspace overview">
                <div class="wd-metrics"><% foreach (var metric in Metrics) { %><article><span><%: metric.Label %></span><strong><%: metric.Value %></strong><p><%: metric.Hint %></p></article><% } %></div>
<div class="wd-overview-grid">
                    <article class="wd-feature"><div class="wd-feature-copy"><h2><%: FocusTitle %></h2><p><%: FocusText %></p><a class="wd-button wd-button-light" href="<%: PrimaryUrl %>"><%: PrimaryLabel %><svg><use href="#i-arrow"/></svg></a></div></article>
                    <article class="wd-status-panel"><div class="wd-panel-heading"><h2>Placement overview</h2><svg><use href="#i-chart"/></svg></div><p>Application decisions at a glance</p><div class="wd-status-chart" role="img" aria-label="<%: ApplicationsAvailable ? PendingCount + " pending, " + ApprovedCount + " approved, " + RejectedCount + " rejected applications" : "Application data unavailable" %>">
                        <% var total = Math.Max(1, PendingCount + ApprovedCount + RejectedCount); %>
                        <div class="wd-chart-bar wd-chart-pending" style="flex-grow:<%= PendingCount %>"></div><div class="wd-chart-bar wd-chart-approved" style="flex-grow:<%= ApprovedCount %>"></div><div class="wd-chart-bar wd-chart-rejected" style="flex-grow:<%= RejectedCount %>"></div>
                        <% if (PendingCount + ApprovedCount + RejectedCount == 0) { %><div class="wd-chart-empty"></div><% } %>
                    </div><ul class="wd-legend"><li><i class="wd-dot pending"></i>Pending<strong><%: ApplicationsAvailable ? PendingCount.ToString() : "—" %></strong></li><li><i class="wd-dot approved"></i>Approved<strong><%: ApplicationsAvailable ? ApprovedCount.ToString() : "—" %></strong></li><li><i class="wd-dot rejected"></i>Rejected<strong><%: ApplicationsAvailable ? RejectedCount.ToString() : "—" %></strong></li></ul><span class="wd-data-caption"><%: ApplicationsAvailable ? "From your current application records" : "Waiting for application access" %></span></article>
                </div>

                <div class="wd-section-heading"><div><h2>Quick actions</h2><p>Continue your internship workflow.</p></div><span class="wd-drag-label">Explore workspace <svg><use href="#i-arrow"/></svg></span></div>
                <% if (Role == "admin") { %><nav class="coordinator-links" aria-label="Coordinator management"><a href="ManageStudents.aspx"><strong>Students</strong><small>Manage enrollment and account details</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="AssignSuper.aspx"><strong>Supervisor assignments</strong><small>Organize groups and academic supervision</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="MonitorPlacements.aspx"><strong>Placements</strong><small>Review tasks, hours and evaluations</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="CompletionReview.aspx"><strong>Completion review</strong><small>Approve completion and create certificates</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="ManageAcademic.aspx"><strong>Academic supervisors</strong><small>Manage academic supervisor accounts</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="ManageCompanies.aspx"><strong>Company supervisors</strong><small>Manage company supervisor accounts</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a></nav><% } %><% if (Role == "company") { %><nav class="company-dashboard-links" aria-label="Company management"><a href="Opportunities.aspx"><strong>Manage opportunities</strong><small>Publish internships and keep listings current</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="Applications.aspx"><strong>Review applications</strong><small>Review candidates and placement decisions</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="Trainees.aspx"><strong>Your trainees</strong><small>Follow students placed with your company</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="Tasks.aspx"><strong>Training tasks</strong><small>Assign work and review student submissions</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="ReportsAndEvaluation.aspx"><strong>Reports &amp; evaluations</strong><small>Review training performance and final evaluations</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="Account.aspx"><strong>Company account</strong><small>Manage your professional and contact details</small><svg aria-hidden="true"><use href="#i-arrow"/></svg></a></nav><% } %><div class="wd-action-rail" tabindex="0" role="region" aria-label="Workspace quick actions" data-drag-rail>
                    <% if (Role == "student") { %>
                    <a class="wd-action-tile" href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>"><svg><use href="#i-bag"/></svg><h3>Explore internships</h3><p>Explore open internships and find where your skills can grow.</p><span>Browse opportunities <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile" href="<%= ResolveUrl("~/Student/MyApplications.aspx") %>"><svg><use href="#i-clock"/></svg><h3>Your applications</h3><p>Follow decisions, review offers and confirm your internship.</p><span>My applications <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile wd-action-photo" href="<%= ResolveUrl("~/Student/StudentProfile.aspx") %>"><h3>Student profile</h3><span>View student profile <svg><use href="#i-arrow"/></svg></span></a>
                    <% } else { %>
                    <a class="wd-action-tile" href="#workspace" data-view="workspace"><svg><use href="#i-user"/></svg><h3><%: Role == "company" ? "Discover your talent." : "People come first." %></h3><p><%: Role == "company" ? "See the opportunities connected to your company." : "Keep the students connected to your workspace in view." %></p><span><%: WorkLabel %> <svg><use href="#i-arrow"/></svg></span></a>
                    <a class="wd-action-tile" href="#activity" data-view="activity"><svg><use href="#i-clock"/></svg><h3>Stay connected.</h3><p>Follow placement decisions and see what needs attention.</p><span>View activity <svg><use href="#i-arrow"/></svg></span></a>
                    <% if (Role != "academic") { %>
                    <a class="wd-action-tile wd-action-photo" href="#reports" data-view="reports"><h3>See the<br>bigger picture.</h3><span>Workspace reports <svg><use href="#i-arrow"/></svg></span></a>
                    <% } %>
                    <% } %>
                </div>
            </section>
            <section data-panel="workspace" id="workspace" hidden aria-labelledby="work-title"><div class="wd-section-heading"><div><h2 id="work-title"><%: WorkLabel %></h2><p><%: Role == "student" ? "Review your submitted applications and respond to offers." : Role == "company" ? "Opportunities published under your company account." : "People connected to your supervision workspace." %></p></div><% if (Role == "student") { %><a class="wd-button" href="<%= ResolveUrl("~/Student/MyApplications.aspx") %>">Manage applications<svg><use href="#i-arrow"/></svg></a><% } %></div>
                <% if (Role == "company") { %><div class="wd-opening-grid"><% foreach (var opening in Openings) { %><article class="wd-opening"><span class="wd-badge"><%: opening.Status %></span><h3><%: opening.Title %></h3><p><%: opening.Location %> · <%: opening.Mode %></p><span>Deadline: <%: opening.Deadline %></span></article><% } %></div><% if (Openings.Count == 0) { %><div class="wd-empty"><svg><use href="#i-bag"/></svg><h3>No company opportunities to show</h3><p>Opportunities linked to your company account will appear here.</p></div><% } %><% } %>
                <% if (Role == "academic" || Role == "admin") { %><div class="wd-people-grid"><% foreach (var person in People) { %><article class="wd-person"><span class="wd-avatar"><svg><use href="#i-user"/></svg></span><div><h3><%: person.Title %></h3><p><%: person.Person %></p></div><span class="wd-badge"><%: person.Status %></span></article><% } %></div><% if (People.Count == 0) { %><div class="wd-empty"><svg><use href="#i-user"/></svg><h3>No student records to show</h3><p><%: Role == "academic" ? "Students assigned to your academic supervisor account will appear here." : "Student accounts will appear here when they are available to your coordinator account." %></p></div><% } %><% } %>
            </section>
            <% if (Role != "academic") { %><section data-panel="reports" id="reports" hidden aria-labelledby="report-title"><div class="wd-section-heading"><div><h2 id="report-title">Workspace reports</h2><p>Export the application records available to your account.</p></div><button class="wd-button" type="button" data-export <%= Rows.Count == 0 ? "disabled" : "" %>>Download CSV<svg><use href="#i-download"/></svg></button></div><div class="wd-report-note"><h3>Application summary</h3><p><%: ApplicationsAvailable ? "This report includes the application titles, students or organizations, decisions and submission dates shown below." : "Application records are unavailable under the current database permissions. An export will become available when records can be read." %></p><p>Exports reflect the records loaded when you opened this page. Refresh to include recent changes.</p></div></section><% } %>
            <section class="wd-activity-panel" id="activity" aria-labelledby="activity-title"><div class="wd-table-toolbar"><div><h2 id="activity-title"><%: ActivityLabel %></h2><p><%: Role == "admin" ? "Search applications and review current decisions." : "Every application. A step forward." %></p></div><div class="wd-table-actions"><label class="wd-search"><svg><use href="#i-search"/></svg><input type="search" id="activitySearch" placeholder="Search activity" aria-label="Search application activity" /></label><select id="activityStatus" aria-label="Filter by application status"><option value="all">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div></div>
                <div class="wd-table-scroll"><table id="activityTable"><thead><tr><th scope="col">Opportunity</th><th scope="col"><%: Role == "student" ? "Organization" : "Student" %></th><th scope="col">Status</th><th scope="col">Applied on</th><% if (Role == "student") { %><th scope="col"><span class="wd-sr-only">Actions</span></th><% } %></tr></thead><tbody><% foreach (var row in Rows) { %><tr data-status="<%: row.Status %>"><td><span class="wd-row-icon"><svg><use href="#i-bag"/></svg></span><strong><%: string.IsNullOrWhiteSpace(row.Title) ? "Internship application" : row.Title %></strong></td><td><%: string.IsNullOrWhiteSpace(row.Person) ? "Not provided" : row.Person %></td><td><span class="wd-badge <%: row.Status.ToLowerInvariant() %>"><%: row.Status %></span></td><td><%: row.Date %></td><% if (Role == "student") { %><td><a class="wd-row-link" href="<%: row.Url %>" aria-label="Review application for <%: row.Title %>"><svg><use href="#i-arrow"/></svg></a></td><% } %></tr><% } %></tbody></table></div>
                <% if (Rows.Count == 0) { %><div class="wd-empty"><svg><use href="#i-bag"/></svg><h3><%: EmptyTitle %></h3><p><%: EmptyDescription %></p><% if (Role == "student") { %><a href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>" class="wd-text-link">Explore opportunities <svg><use href="#i-arrow"/></svg></a><% } %></div><% } %>
                <p class="wd-filter-empty" hidden>No applications match your search. Try another name or status.</p><p class="wd-table-count" role="status" aria-live="polite"><span id="visibleCount"><%: Rows.Count %></span> records in this workspace</p>
            </section>
            <section class="wd-recommendations" data-student-openings <%= Role != "student" ? "hidden" : "" %>><div class="wd-section-heading"><div><h2>Open opportunities</h2><p>Open opportunities from the portal.</p></div><a class="wd-text-link" href="<%= ResolveUrl("~/Student/Opportunities.aspx") %>">View all <svg><use href="#i-arrow"/></svg></a></div><div class="wd-opening-grid"><% foreach (var opening in Openings.Take(3)) { %><a class="wd-opening" href="<%: opening.Url %>"><span class="wd-badge approved">Open</span><h3><%: opening.Title %></h3><p><%: opening.Location %> · <%: opening.Mode %></p><span><%: opening.Deadline %><svg><use href="#i-arrow"/></svg></span></a><% } %></div><% if (Role == "student" && Openings.Count == 0) { %><p class="wd-muted">No open opportunities are available right now. Check back for your next chapter.</p><% } %></section>
            <asp:ContentPlaceHolder ID="WorkspaceContent" runat="server" />

</div><script src="<%= ResolveUrl("~/Scripts/workspace.js?v=3") %>"></script>
</asp:Content>

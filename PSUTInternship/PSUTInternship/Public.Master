<%@ Master Language="C#" CodeBehind="Public.Master.cs" Inherits="PSUTInternship.PublicLayout" %>
<%@ Register Src="~/Shared/Dialogs.ascx" TagPrefix="psut" TagName="Dialogs" %>
<!doctype html>
<html lang="en">
<head runat="server">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PSUT · Internship Portal</title>
<link rel="icon" href="<%= ResolveUrl("~/Assets/psut-logo.jpg") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/vendor/bootstrap.min.css") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/portal.css?v=20261021j") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/wellington.css") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/motion.css") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/homepage-interactions.css?v=20261021m") %>">
</head>
<body class="reference-homepage" data-role="" data-page="">
<asp:ContentPlaceHolder ID="MainContent" runat="server" />
<psut:Dialogs runat="server" ID="Dialogs" />
<script>window.PSUT={root:'<%= ResolveUrl("~/") %>',role:document.body.dataset.role||'student',page:document.body.dataset.page||'Overview'};</script>
<script src="<%= ResolveUrl("~/Scripts/vendor/bootstrap.bundle.min.js") %>">
</script>
<script src="<%= ResolveUrl("~/Scripts/portal.js") %>">
</script>


<script src="<%= ResolveUrl("~/Scripts/wellington.js") %>">
</script>
<script src="<%= ResolveUrl("~/Scripts/motion.js?v=20261021c") %>">
</script>
<script src="<%= ResolveUrl("~/Scripts/interactions.js?v=20261021b") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/hero.js?v=20261021c") %>"></script>
</body>
</html>

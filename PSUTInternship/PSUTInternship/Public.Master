<%@ Master Language="C#" CodeBehind="Public.Master.cs" Inherits="PSUTInternship.PublicLayout" %>
<!doctype html>
<html lang="en">
<head runat="server">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Discover your next chapter at Princess Sumaya University for Technology. Explore campus life, internship opportunities, and your PSUT workspace.">
<title>PSUT · Your next chapter</title>
<link rel="icon" type="image/png" href="<%= ResolveUrl("~/Assets/psut-emblem.png") %>">
<link rel="preload" href="<%= ResolveUrl("~/Assets/manrope-variable.ttf") %>" as="font" type="font/ttf" crossorigin>
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/vendor/bootstrap.min.css") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/portal.css") %>">
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/campus-home.css?v=20261024-fhd37") %>">
</head>
<body class="campus-home" data-role="" data-page="">
<form id="PublicForm" runat="server">
<asp:ContentPlaceHolder ID="MainContent" runat="server" />
</form>
<div class="psut-modal" id="detail"><div class="modalbox" id="detailContent"></div></div><div class="psut-modal" id="action"><div class="modalbox" id="actionContent"></div></div><div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>window.PSUT={root:'<%= ResolveUrl("~/") %>',role:'student',page:'Overview'};</script>
<script src="<%= ResolveUrl("~/Scripts/vendor/bootstrap.bundle.min.js") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/portal.js?v=20261024-revert35") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/wellington.js?v=contact2") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/interactions.js?v=20261023-loop24") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/campus-home.js?v=20261024-fhd37") %>"></script>

</body>
</html>

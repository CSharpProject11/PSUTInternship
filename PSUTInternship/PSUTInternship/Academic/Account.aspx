<%@ Page Language="C#" AutoEventWireup="true" Async="true" CodeBehind="Account.aspx.cs" Inherits="AcademicSupervisor.Account" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Academic Supervisor Account | UIMS</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
<style>
*{box-sizing:border-box}body{margin:0;background:#f3f6fc;color:#152944;font-family:Inter,Arial,sans-serif;font-size:13px}a{text-decoration:none}.layout{display:flex;min-height:100vh}.sidebar{width:260px;flex-shrink:0;background:linear-gradient(180deg,#102544,#0c1d38);color:#fff;padding:27px 17px}.brand{font-size:27px;font-weight:800;letter-spacing:1px;padding:0 10px;margin-bottom:46px}.brand small{display:block;margin-top:7px;font-size:9px;letter-spacing:1.5px;color:#a8c5ef;font-weight:500}.nav-title{color:#91a7c7;font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:0 12px;margin:0 0 13px}.nav-link{display:flex;align-items:center;gap:12px;padding:14px 13px;border-radius:10px;color:#dce8fa;margin:5px 0}.nav-link i{font-size:17px;width:20px;text-align:center}.nav-link:hover{background:#203b60;color:white}.nav-link.active{background:linear-gradient(100deg,#2869e8,#1b50b8);color:#fff;font-weight:700}.nav-divider{height:1px;background:#ffffff24;margin:24px 8px}.main{flex:1;min-width:0}.topbar{background:white;min-height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 36px;border-bottom:1px solid #e5ebf5}.chip{background:#eef4ff;border-radius:40px;padding:10px 16px;color:#2359b6;font-size:12px}.content{max-width:1540px;margin:auto;padding:35px 36px}.eyebrow{color:#2563eb;font-weight:800;letter-spacing:2px;font-size:10px;text-transform:uppercase}h1{font-size:32px;letter-spacing:-.8px;margin:13px 0 10px}.subtitle{color:#75839b;margin:0 0 25px;line-height:1.7}.banner{display:flex;align-items:center;gap:18px;background:white;border:1px solid #e5ebf5;border-radius:18px;padding:24px 28px;margin-bottom:22px;box-shadow:0 8px 25px #15294408}.avatar{height:66px;width:66px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#deebff;color:#2460c9;font-weight:800;font-size:22px}.banner h2{margin:0 0 6px;font-size:19px}.muted{color:#7e8da5;font-size:12px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.card{background:#fff;border:1px solid #e5ebf5;border-radius:18px;padding:24px;box-shadow:0 8px 24px #15294409;min-width:0}.card-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:23px}.head-left{display:flex;align-items:center;gap:12px}.head-icon{height:42px;width:42px;border-radius:12px;background:#e9f1ff;color:#2361d4;display:flex;align-items:center;justify-content:center;font-size:19px}.head-icon.purple{background:#f1eaff;color:#7c3aed}.head-icon.green{background:#e3faee;color:#059669}.card.security{grid-column:1/-1}.security-info{border:1px solid #e3ebf7;background:#f7faff;border-radius:12px;padding:18px;line-height:1.9}.password-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:20px}.notice{padding:13px 16px;border-radius:11px;margin:0 0 17px;line-height:1.6}.notice.error{background:#fff0f0;color:#b91c1c;border:1px solid #ffd5d5}.notice.ok{background:#ecfdf3;color:#047857;border:1px solid #c3f0d6}.card h3{margin:0;font-size:17px}.card-head p{margin:5px 0 0;color:#8391a7;font-size:11px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.field.wide{grid-column:1/-1}.field label{display:block;font-weight:700;font-size:11px;margin-bottom:9px;color:#344d72}.field-value{min-height:43px;display:flex;align-items:center;overflow-wrap:anywhere;color:#294363;background:#f6f9ff;border:1px solid #eaf0f9;border-radius:9px;padding:11px 13px}.textbox{width:100%;height:43px;border:1px solid #d2e0f2;border-radius:9px;padding:0 13px;font:inherit;color:#233b60;outline:none}.textbox:focus{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb14}.hint{margin-top:7px;font-size:10px;color:#8694aa}.btn{border:0;border-radius:9px;padding:11px 16px;cursor:pointer;font:700 11px Inter,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;background:#2563eb;color:white}.btn:hover{background:#1748ad}.btn-light{background:#edf4ff;color:#2458b5}.btn-light:hover{background:#dce9ff}.btn-outline{background:white;border:1px solid #d9e5f7;color:#265cb7}.btn-outline:hover{background:#eff5ff}.card-actions{display:flex;gap:9px;justify-content:flex-end;margin-top:21px}.footer{text-align:center;color:#8897aa;padding:22px;font-size:10px}.empty{color:#a16207}.read-only{background:#f4f6fa;color:#75839b}@media(max-width:1050px){.cards{grid-template-columns:1fr}.card.security{grid-column:auto}.password-grid{grid-template-columns:1fr}}@media(max-width:700px){.layout{display:block}.sidebar{width:100%}.content{padding:25px 15px}.topbar{padding:15px}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.banner{padding:18px}}
</style></head><body><form id="form1" runat="server"><div class="layout">
<aside class="sidebar"><div class="brand">UIMS<small>INTERNSHIP MANAGEMENT</small></div><div class="nav-title">Academic Supervisor</div>
<a class="nav-link" href="Dashboard.aspx"><i class="bi bi-grid-1x2"></i>Dashboard</a><a class="nav-link" href="StudentProgress.aspx"><i class="bi bi-pie-chart"></i>Student Progress</a><a class="nav-link" href="FinalEvaluation.aspx"><i class="bi bi-clipboard-check"></i>Final Evaluation</a><a class="nav-link" href="ZommMeetings.html"><i class="bi bi-camera-video"></i>Zoom Meetings</a><a class="nav-link active" href="Account.aspx"><i class="bi bi-person-circle"></i>My Account</a><div class="nav-divider"></div><div class="nav-title">General</div><a class="nav-link" href="Default.aspx"><i class="bi bi-arrow-left"></i>Back to Home</a></aside>
<div class="main"><header class="topbar"><strong>Academic Supervisor Portal</strong><span class="chip"><i class="bi bi-person-circle"></i> <asp:Label ID="lblTopName" runat="server" Text="My Account"/></span></header>
<main class="content"><div class="eyebrow">Profile Settings</div><h1>Academic Supervisor Account</h1><p class="subtitle">View and update your profile information and password.</p>
<div class="banner"><span class="avatar"><asp:Label ID="lblInitials" runat="server" Text="--"/></span><div><h2><asp:Label ID="lblHeaderName" runat="server" Text="Academic Supervisor"/></h2><div class="muted"><asp:Label ID="lblHeaderDepartment" runat="server" Text="Department"/> · Academic Supervisor</div></div></div>
<div class="cards">
<section class="card"><div class="card-head"><div class="head-left"><span class="head-icon"><i class="bi bi-person-vcard"></i></span><div><h3>Personal Information</h3><p>Your contact and identity details</p></div></div><asp:LinkButton ID="btnEditPersonal" runat="server" CssClass="btn btn-outline" CausesValidation="false" OnClick="btnEditPersonal_Click"><i class="bi bi-pencil-square"></i> Edit</asp:LinkButton></div>
<asp:Panel ID="pnlPersonalView" runat="server"><div class="fields"><div class="field wide"><label>Full Name</label><div class="field-value"><asp:Label ID="lblName" runat="server"/></div></div><div class="field"><label>Mobile Number</label><div class="field-value"><asp:Label ID="lblPhone" runat="server"/></div></div><div class="field"><label>Account Role</label><div class="field-value">Academic Supervisor</div></div></div></asp:Panel>
<asp:Panel ID="pnlPersonalEdit" runat="server" Visible="false"><div class="fields"><div class="field wide"><label>Full Name *</label><asp:TextBox ID="txtName" runat="server" CssClass="textbox" MaxLength="100"/></div><div class="field"><label>Mobile Number</label><asp:TextBox ID="txtPhone" runat="server" CssClass="textbox" MaxLength="20" placeholder="0791234567"/></div></div><div class="card-actions"><asp:Button ID="btnCancelPersonal" runat="server" Text="Cancel" CssClass="btn btn-light" CausesValidation="false" OnClick="btnCancelPersonal_Click"/><asp:Button ID="btnSavePersonal" runat="server" Text="Save Changes" CssClass="btn" CausesValidation="false" OnClick="btnSavePersonal_Click"/></div></asp:Panel></section>
<section class="card"><div class="card-head"><div class="head-left"><span class="head-icon purple"><i class="bi bi-mortarboard"></i></span><div><h3>Academic Information</h3><p>University and department details</p></div></div><asp:LinkButton ID="btnEditAcademic" runat="server" CssClass="btn btn-outline" CausesValidation="false" OnClick="btnEditAcademic_Click"><i class="bi bi-pencil-square"></i> Edit</asp:LinkButton></div>
<asp:Panel ID="pnlAcademicView" runat="server"><div class="fields"><div class="field"><label>Department</label><div class="field-value"><asp:Label ID="lblDepartment" runat="server"/></div></div><div class="field"><label>Office Number / Location</label><div class="field-value"><asp:Label ID="lblOffice" runat="server"/></div></div><div class="field wide"><label>University Email</label><div class="field-value"><asp:Label ID="lblEmail" runat="server"/></div></div><div class="field wide"><label>Office Hours</label><div class="field-value"><asp:Label ID="lblOfficeHours" runat="server"/></div></div></div></asp:Panel>
<asp:Panel ID="pnlAcademicEdit" runat="server" Visible="false"><div class="fields"><div class="field"><label>Department *</label><asp:TextBox ID="txtDepartment" runat="server" CssClass="textbox" MaxLength="100"/></div><div class="field"><label>Office Location</label><asp:TextBox ID="txtOffice" runat="server" CssClass="textbox" MaxLength="120"/></div><div class="field wide"><label>University Email (managed by university)</label><asp:TextBox ID="txtEmail" runat="server" CssClass="textbox read-only" ReadOnly="true"/><div class="hint">To change this email, contact the university administrator.</div></div><div class="field wide"><label>Office Hours</label><asp:TextBox ID="txtOfficeHours" runat="server" CssClass="textbox" MaxLength="160" placeholder="Sun–Tue, 10:00 AM – 12:00 PM"/></div></div><div class="card-actions"><asp:Button ID="btnCancelAcademic" runat="server" Text="Cancel" CssClass="btn btn-light" CausesValidation="false" OnClick="btnCancelAcademic_Click"/><asp:Button ID="btnSaveAcademic" runat="server" Text="Save Changes" CssClass="btn" CausesValidation="false" OnClick="btnSaveAcademic_Click"/></div></asp:Panel></section>

<section class="card security">
  <div class="card-head">
    <div class="head-left">
      <span class="head-icon green"><i class="bi bi-shield-lock"></i></span>
      <div><h3>Security</h3><p>Manage your password</p></div>
    </div>
    <span class="btn btn-outline"><i class="bi bi-key"></i> Change Password</span>
  </div>
  <div class="security-info"><strong><i class="bi bi-lock"></i> Password</strong><div class="muted">Change your account password</div></div>
  <div class="password-grid">
    <div class="field"><label for="currentPasswordUI">Current Password</label><input id="currentPasswordUI" type="password" class="textbox" autocomplete="off" /></div>
    <div class="field"><label for="newPasswordUI">New Password</label><input id="newPasswordUI" type="password" class="textbox" autocomplete="off" /></div>
    <div class="field"><label for="confirmPasswordUI">Confirm New Password</label><input id="confirmPasswordUI" type="password" class="textbox" autocomplete="off" /></div>
  </div>
  <div class="card-actions">
    <button type="button" class="btn btn-light" onclick="document.querySelectorAll('#currentPasswordUI,#newPasswordUI,#confirmPasswordUI').forEach(function(x){x.value='';})">Cancel</button>
    <button type="button" class="btn">Update Password</button>
  </div>
</section>
</div></main><footer class="footer">University Internship Management System · Academic Supervisor</footer></div></div></form></body></html>

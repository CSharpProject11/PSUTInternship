body.portal-app .portal-content .academic-account .account-section .card-head{display:flex!important;justify-content:space-between!important;align-items:flex-start!important;gap:20px;margin:0 0 24px!important;background:transparent!important;padding:0!important}.academic-account .head-left{display:block}.academic-account .head-icon{display:none!important}.academic-account h3{font-size:18px!important;margin:0 0 7px!important}.academic-account .card-head p{font-size:12px!important;font-weight:400!important;color:#607587;margin:0!important;line-height:1.7}.academic-account .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.academic-account .field.wide{grid-column:1/-1}.academic-account .field label{display:block;font-size:11px!important;font-weight:500!important;color:#607587;margin-bottom:7px}.academic-account .field-value{font-size:14px;font-weight:600;color:#25485f;overflow-wrap:anywhere}.academic-account .hint{font-size:11px;color:#607587;margin-top:8px}.academic-account .security-info{margin:0 0 20px!important}.academic-account .security-info .muted{font-size:12px;color:#607587;margin-top:6px}
body.portal-app .portal-content .academic-account .btn{display:inline-flex!important;justify-content:center;align-items:center;font-size:12px!important;min-height:40px!important;padding:10px 16px!important;border-radius:7px!important;border:1px solid #003e73!important;background:#003e73!important;color:#fff!important;margin:0!important;line-height:1.5!important;text-decoration:none}body.portal-app .portal-content .academic-account :is(.btn-outline,.btn-light){background:#fff!important;color:#34566f!important;border-color:#cddce6!important}.academic-account .btn i{display:none}.academic-account .profile-dialog{width:min(520px,calc(100vw - 32px));max-height:90dvh;overflow:auto;border:0;border-radius:12px;padding:26px;box-sizing:border-box;color:#19394f}.academic-account .profile-dialog::backdrop{background:#071f3299}.academic-account .profile-dialog h2{font-size:21px!important;margin:0 0 24px!important}.academic-account .profile-dialog .textbox{width:100%;box-sizing:border-box;min-height:44px;border:1px solid #cddce6!important;border-radius:7px;padding:11px 13px;font-size:13px;background:#fff}.academic-account .card-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:24px}.academic-account .field-error{display:block;color:#ac3c3c;font-size:12px;margin-bottom:12px}.academic-account .message:empty{display:none}

<asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server">
<div class="account-container academic-account">

<asp:Label ID="lblTopName" runat="server" Visible="false"/><div class="heading"><h1>My account</h1><p>Manage your contact information and account security.</p></div>
<div class="coordinator-settings"><aside class="settings-identity"><div class="settings-monogram" aria-hidden="true"><asp:Label ID="lblInitials" runat="server" Text="AS"/></div><h2><asp:Label ID="lblHeaderName" runat="server" Text="Academic supervisor"/></h2><p>Academic supervisor</p><dl><div><dt>Department</dt><dd><asp:Label ID="lblHeaderDepartment" runat="server" Text="Department"/></dd></div><div><dt>Account access</dt><dd>Academic supervision workspace</dd></div></dl><nav aria-label="Account sections"><a href="#personalSettings">Personal information <span aria-hidden="true">&#8594;</span></a><a href="#academicSettings">Academic details <span aria-hidden="true">&#8594;</span></a><a href="#securitySettings">Password &amp; security <span aria-hidden="true">&#8594;</span></a></nav></aside><div class="settings-content"><asp:Label ID="ProfileMessage" runat="server" CssClass="message" role="status" />
<section class="account-section" id="personalSettings"><div class="card-head"><div class="head-left"><span class="head-icon"><i class="bi bi-person-vcard"></i></span><div><h3>Personal Information</h3><p>Your contact and identity details</p></div></div><asp:LinkButton ID="btnEditPersonal" runat="server" CssClass="btn btn-outline" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnEditPersonal_Click"><i class="bi bi-pencil-square"></i> Edit</asp:LinkButton></div>
<asp:Panel ID="pnlPersonalView" runat="server"><div class="fields"><div class="field wide"><label>Full Name</label><div class="field-value"><asp:Label ID="lblName" runat="server"/></div></div><div class="field"><label>Mobile Number</label><div class="field-value"><asp:Label ID="lblPhone" runat="server"/></div></div><div class="field"><label>Account Role</label><div class="field-value">Academic Supervisor</div></div></div></asp:Panel>
<asp:Panel ID="pnlPersonalEdit" runat="server" Visible="false" CssClass="profile-editor"><dialog class="profile-dialog" aria-label="Edit personal information"><h2>Edit personal information</h2><asp:Label ID="PersonalError" runat="server" CssClass="field-error" role="alert" /><div class="fields"><div class="field wide"><label>Full Name *</label><asp:TextBox ID="txtName" runat="server" CssClass="textbox" MaxLength="100"/></div><div class="field"><label>Mobile Number</label><asp:TextBox ID="txtPhone" runat="server" CssClass="textbox" MaxLength="20" placeholder="0791234567"/></div></div><div class="card-actions"><asp:Button ID="btnCancelPersonal" runat="server" data-profile-cancel="true" Text="Cancel" CssClass="btn btn-light" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnCancelPersonal_Click"/><asp:Button ID="btnSavePersonal" runat="server" Text="Save Changes" CssClass="btn" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnSavePersonal_Click"/></div></dialog></asp:Panel></section>
<section class="account-section" id="academicSettings"><div class="card-head"><div class="head-left"><span class="head-icon purple"><i class="bi bi-mortarboard"></i></span><div><h3>Academic Information</h3><p>University and department details</p></div></div><asp:LinkButton ID="btnEditAcademic" runat="server" CssClass="btn btn-outline" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnEditAcademic_Click"><i class="bi bi-pencil-square"></i> Edit</asp:LinkButton></div>
<asp:Panel ID="pnlAcademicView" runat="server"><div class="fields"><div class="field"><label>Department</label><div class="field-value"><asp:Label ID="lblDepartment" runat="server"/></div></div><div class="field"><label>Office Number / Location</label><div class="field-value"><asp:Label ID="lblOffice" runat="server"/></div></div><div class="field wide"><label>University Email</label><div class="field-value"><asp:Label ID="lblEmail" runat="server"/></div></div><div class="field wide"><label>Office Hours</label><div class="field-value"><asp:Label ID="lblOfficeHours" runat="server"/></div></div></div></asp:Panel>
<asp:Panel ID="pnlAcademicEdit" runat="server" Visible="false" CssClass="profile-editor"><dialog class="profile-dialog" aria-label="Edit academic information"><h2>Edit academic information</h2><asp:Label ID="AcademicError" runat="server" CssClass="field-error" role="alert" /><div class="fields"><div class="field"><label>Department *</label><asp:TextBox ID="txtDepartment" runat="server" CssClass="textbox" MaxLength="100"/></div><div class="field"><label>Office Location</label><asp:TextBox ID="txtOffice" runat="server" CssClass="textbox" MaxLength="120"/></div><div class="field wide"><label>University Email (managed by university)</label><asp:TextBox ID="txtEmail" runat="server" CssClass="textbox read-only" ReadOnly="true"/><div class="hint">To change this email, contact the university administrator.</div></div><div class="field wide"><label>Office Hours</label><asp:TextBox ID="txtOfficeHours" runat="server" CssClass="textbox" MaxLength="160" placeholder="Sun–Tue, 10:00 AM – 12:00 PM"/></div></div><div class="card-actions"><asp:Button ID="btnCancelAcademic" runat="server" data-profile-cancel="true" Text="Cancel" CssClass="btn btn-light" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnCancelAcademic_Click"/><asp:Button ID="btnSaveAcademic" runat="server" Text="Save Changes" CssClass="btn" CausesValidation="false" formnovalidate="formnovalidate" OnClick="btnSaveAcademic_Click"/></div></dialog></asp:Panel></section>

<section class="account-section" id="securitySettings">
  <div class="card-head">
    <div class="head-left">
      <span class="head-icon green"><i class="bi bi-shield-lock"></i></span>
      <div><h3>Security</h3><p>Manage your password</p></div>
    </div>

  </div>
  <div class="security-info"><strong><i class="bi bi-lock"></i> Password</strong><div class="muted">Change your account password</div></div>
  <a class="btn" href="../ChangePassword.aspx">Change password</a>
</section>
</div></div></div>
</asp:Content>

</style></asp:Content><asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server">
    <dialog id="passwordDialog" class="password-settings-dialog" aria-labelledby="passwordDialogTitle"><div class="password-dialog-header"><div><h1 id="passwordDialogTitle">Change password</h1><p>Keep your account secure.</p></div><a class="password-dialog-close" aria-label="Close password settings" href="<%= ResolveUrl(PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "company" ? "~/Company/Account.aspx" : PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "academic" ? "~/Academic/Account.aspx" : PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "admin" ? "~/Admin/CoordinatorAccount.aspx" : "~/Student/StudentProfile.aspx") %>">×</a></div><div class="password-settings-page"><h1>Change password</h1><p class="subtitle">Update your account password securely.</p>
    <div class="password-settings-layout"><section class="password-settings-form"><h2>Choose a new password</h2><p class="password-settings-description">Use a unique password to protect your account.</p>
        <asp:Label ID="passwordMessage" runat="server" CssClass="message error" role="alert" />
        <div class="password-settings-fields"><div class="field"><asp:Label runat="server" AssociatedControlID="currentPassword" Text="Current password" /><div class="password-input-wrap"><asp:TextBox ID="currentPassword" runat="server" TextMode="Password" autocomplete="current-password" /><button type="button" class="password-visibility" aria-label="Show password" aria-pressed="false">Show</button></div></div>
            <div class="field"><asp:Label runat="server" AssociatedControlID="newPassword" Text="New password" /><div class="password-input-wrap"><asp:TextBox ID="newPassword" runat="server" TextMode="Password" autocomplete="new-password" /><button type="button" class="password-visibility" aria-label="Show password" aria-pressed="false">Show</button></div></div>
            <div class="field"><asp:Label runat="server" AssociatedControlID="confirmPassword" Text="Confirm password" /><div class="password-input-wrap"><asp:TextBox ID="confirmPassword" runat="server" TextMode="Password" autocomplete="new-password" /><button type="button" class="password-visibility" aria-label="Show password" aria-pressed="false">Show</button></div></div>
        </div>
<div class="portal-form-actions"><asp:Button ID="savePassword" runat="server" Text="Save password" OnClick="savePassword_Click" /></div>
    </section><aside class="password-settings-guidance"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><h2>Keep your account secure</h2><p>Use at least 8 characters and choose a password you do not use for other accounts.</p><ul><li>A longer password is harder to guess.</li><li>Avoid your name, student number or company name.</li><li>Never share your password.</li></ul></aside></div></div>
</dialog><script>
var passwordDialog=document.getElementById("passwordDialog");passwordDialog.showModal();passwordDialog.addEventListener("cancel",function(e){e.preventDefault();window.location.href="<%= ResolveUrl(PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "company" ? "~/Company/Account.aspx" : PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "academic" ? "~/Academic/Account.aspx" : PSUTInternship.Shared.PortalRoles.Normalize(Convert.ToString(Session["userRole"])) == "admin" ? "~/Admin/CoordinatorAccount.aspx" : "~/Student/StudentProfile.aspx") %>";});
document.querySelectorAll('.password-visibility').forEach(function(button){button.addEventListener('click',function(){var input=button.previousElementSibling;var show=input.type==='password';input.type=show?'text':'password';button.textContent=show?'Hide':'Show';button.setAttribute('aria-pressed',String(show));button.setAttribute('aria-label',show?'Hide password':'Show password');});});
</script><script>
if(new URLSearchParams(location.search).get('embedded')==='1'&&window.parent!==window){
 document.documentElement.classList.add('password-embedded');
 var reportPasswordHeight=function(){window.parent.postMessage({type:'password-settings-height',height:Math.ceil(document.getElementById('passwordDialog').getBoundingClientRect().height)},location.origin);};new ResizeObserver(reportPasswordHeight).observe(document.getElementById('passwordDialog'));reportPasswordHeight();
 var closePassword=function(e){if(e)e.preventDefault();window.parent.postMessage('close-password-settings',location.origin);};
 document.querySelector('.password-dialog-close').addEventListener('click',closePassword);
 document.getElementById('passwordDialog').addEventListener('cancel',function(e){e.stopImmediatePropagation();closePassword(e);},true);
}
</script></asp:Content>

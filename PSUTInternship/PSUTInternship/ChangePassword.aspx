.password-settings-dialog .password-dialog-header{background:#fff!important;padding:24px 26px 20px!important;border-bottom:0!important;align-items:flex-start!important}
body.portal-app .portal-content .password-settings-dialog .password-dialog-header h1{font-size:22px!important;line-height:1.3!important;letter-spacing:-.025em!important;margin:0 0 6px!important}
body.portal-app .portal-content .password-settings-dialog .password-dialog-header p{font-size:12px!important;font-weight:400!important;color:#6a7f8f!important}
body.portal-app .portal-content .password-settings-dialog .password-settings-form{padding:4px 26px 24px!important}

@media(max-width:550px){body.portal-app .portal-content .password-settings-dialog .password-settings-form{padding:20px!important}.password-dialog-header{padding:20px}body.portal-app .portal-content .password-settings-dialog .portal-form-actions{margin:24px -20px -20px!important;padding:16px 20px!important}}
</style><style>

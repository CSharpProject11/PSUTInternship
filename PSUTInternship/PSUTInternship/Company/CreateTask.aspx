<%@ Page Title="Create task" MasterPageFile="~/Portal.Master" Language="C#" AutoEventWireup="true" Async="true" CodeBehind="CreateTask.aspx.cs" Inherits="PSUTInternship.Company.CreateTask" %>
<asp:Content ID="PageHead" ContentPlaceHolderID="PortalHead" runat="server"><link rel="stylesheet" href="../Content/company-tasks.css?v=2" /></asp:Content>
<asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server">
<div class="company-task-page company-task-create"><a class="sd-back" href="Tasks.aspx">← Back to tasks</a><h1>Create task</h1><p class="subtitle">Set clear expectations for your confirmed trainees.</p>
<asp:Label ID="PageMessage" runat="server" CssClass="message" role="status" /><div class="task-authoring-layout"><section class="task-writing-section"><h2>Task brief</h2><p class="task-section-intro">Describe the work and how you will evaluate it.</p><div class="task-writing-fields"><div class="field wide"><label for="<%= Titelinput.ClientID %>">Task title</label><input id="Titelinput" type="text" runat="server" /><asp:Label ID="ErrorTitel" runat="server" CssClass="field-error" /></div><div class="field wide"><label for="<%= Descriptioniput.ClientID %>">Description</label><textarea id="Descriptioniput" rows="5" runat="server"></textarea><asp:Label ID="ErorrDescreption" runat="server" CssClass="field-error" /></div><div class="field wide"><label for="<%= EvaluationCriteriainput.ClientID %>">Evaluation criteria</label><textarea id="EvaluationCriteriainput" rows="3" runat="server"></textarea><asp:Label ID="ErorrEvaluation" runat="server" CssClass="field-error" /></div></div></section><aside class="task-assignment-section"><h2>Assignment &amp; schedule</h2><p class="task-section-intro">Choose who receives this task and when it is due.</p><div class="task-assignment-fields"><div class="field"><asp:Label runat="server" AssociatedControlID="Opportunity" Text="Training opportunity" /><asp:DropDownList ID="Opportunity" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Opportunity_Changed" /><asp:Label ID="OpportunityError" runat="server" CssClass="field-error" /></div><div class="field"><label>Assign trainees</label><details class="portal-trainee-picker"><summary>Select trainees</summary><asp:CheckBoxList ID="cblStudents" runat="server" /></details><asp:Label ID="ErorrAssign" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Deadlineinput" Text="Deadline" /><asp:TextBox ID="Deadlineinput" runat="server" TextMode="Date" /><asp:Label ID="ErorrDeadline" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="TrainingHours" Text="Training hours on completion" /><asp:TextBox ID="TrainingHours" runat="server" TextMode="Number" min="0" step="0.01" placeholder="e.g. 30" /><p class="task-section-intro">Credited when this task is marked complete. No maximum.</p><asp:Label ID="TrainingHoursError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="prorityinput" Text="Priority" /><asp:DropDownList ID="prorityinput" runat="server"><asp:ListItem>Low</asp:ListItem><asp:ListItem>Medium</asp:ListItem><asp:ListItem>High</asp:ListItem></asp:DropDownList></div></div></aside></div><div class="portal-form-actions"><asp:Button ID="Cancel" runat="server" OnClick="Cancel_Click" Text="Cancel" CssClass="btn light" CausesValidation="false" formnovalidate="formnovalidate" /><asp:Button ID="CreateTaskButton" runat="server" OnClick="CreateTask_Click" Text="Create task" CssClass="btn" /></div></div>
</asp:Content>
<%@ Page Title="Student profile" MasterPageFile="~/Portal.Master" Language="C#" AutoEventWireup="true" Async="true" CodeBehind="StudentProfile.aspx.cs" Inherits="PSUTInternship.Student.StudentProfile" %>
<asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server"><h1>Student profile</h1><p class="subtitle">Manage your personal, academic and professional information.</p><p>Academic supervisor: <asp:Label ID="assignedSupervisor" runat="server" /></p><asp:Label ID="lblMessage" runat="server" CssClass="message" role="status" /><div class="profile-grid"><section class="panel"><div class="panel-heading"><h2>Personal information</h2><asp:Button ID="EditPersonal" runat="server" Text="Edit" CommandArgument="Personal" OnCommand="EditSection" CssClass="btn light" CausesValidation="false" formnovalidate="formnovalidate" /></div><asp:Literal ID="PersonalDetails" runat="server" /></section><section class="panel"><div class="panel-heading"><h2>Academic information</h2><asp:Button ID="EditAcademic" runat="server" Text="Edit" CommandArgument="Academic" OnCommand="EditSection" CssClass="btn light" CausesValidation="false" formnovalidate="formnovalidate" /></div><asp:Literal ID="AcademicDetails" runat="server" /></section><section class="panel"><div class="panel-heading"><h2>Professional information</h2><asp:Button ID="EditProfessional" runat="server" Text="Edit" CommandArgument="Professional" OnCommand="EditSection" CssClass="btn light" CausesValidation="false" formnovalidate="formnovalidate" /></div><asp:Literal ID="ProfessionalDetails" runat="server" /></section></div><section class="panel"><h2>Password</h2><a class="btn" href="../ChangePassword.aspx">Change password</a></section><asp:Panel ID="PersonalEditor" runat="server" Visible="false" CssClass="profile-editor"><dialog class="profile-dialog" aria-label="Edit personal information"><h2>Edit personal information</h2><asp:Label ID="PersonalError" runat="server" CssClass="field-error" role="alert" /><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="txtDateOfBirth" Text="Date of birth" /><asp:TextBox ID="txtDateOfBirth" runat="server" TextMode="Date" /><asp:Label ID="txtDateOfBirthError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtPhone" Text="Phone number" /><asp:TextBox ID="txtPhone" runat="server" TextMode="Phone" /><asp:Label ID="txtPhoneError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="ddlGender" Text="Gender" /><asp:DropDownList ID="ddlGender" runat="server"><asp:ListItem Value="">Not specified</asp:ListItem><asp:ListItem>Male</asp:ListItem><asp:ListItem>Female</asp:ListItem></asp:DropDownList></div></div><p class="muted">Name, email, student ID, university, faculty and major are managed by the coordinator.</p><div class="portal-form-actions"><asp:Button ID="CancelPersonal" runat="server" Text="Cancel" OnClick="CancelSection" CssClass="btn light" data-profile-cancel="true" CausesValidation="false" formnovalidate="formnovalidate" /><asp:Button ID="SavePersonal" runat="server" Text="Save changes" CommandArgument="Personal" OnCommand="SaveSection" CssClass="btn" /></div></dialog></asp:Panel><asp:Panel ID="AcademicEditor" runat="server" Visible="false" CssClass="profile-editor"><dialog class="profile-dialog" aria-label="Edit academic information"><h2>Edit academic information</h2><asp:Label ID="AcademicError" runat="server" CssClass="field-error" role="alert" /><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="txtGPA" Text="GPA (0–4)" /><asp:TextBox ID="txtGPA" runat="server" TextMode="SingleLine" /><asp:Label ID="txtGPAError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtSemester" Text="Academic semester" /><asp:TextBox ID="txtSemester" runat="server" TextMode="SingleLine" /><asp:Label ID="txtSemesterError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtCompletedHours" Text="Completed credit hours" /><asp:TextBox ID="txtCompletedHours" runat="server" TextMode="Number" /><asp:Label ID="txtCompletedHoursError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtApplicationDate" Text="Application date" /><asp:TextBox ID="txtApplicationDate" runat="server" TextMode="Date" /><asp:Label ID="txtApplicationDateError" runat="server" CssClass="field-error" /></div></div><p class="muted">Name, email, student ID, university, faculty and major are managed by the coordinator.</p><div class="portal-form-actions"><asp:Button ID="CancelAcademic" runat="server" Text="Cancel" OnClick="CancelSection" CssClass="btn light" data-profile-cancel="true" CausesValidation="false" formnovalidate="formnovalidate" /><asp:Button ID="SaveAcademic" runat="server" Text="Save changes" CommandArgument="Academic" OnCommand="SaveSection" CssClass="btn" /></div></dialog></asp:Panel><asp:Panel ID="ProfessionalEditor" runat="server" Visible="false" CssClass="profile-editor"><dialog class="profile-dialog" aria-label="Edit professional information"><h2>Edit professional information</h2><asp:Label ID="ProfessionalError" runat="server" CssClass="field-error" role="alert" /><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="txtGithub" Text="GitHub URL" /><asp:TextBox ID="txtGithub" runat="server" TextMode="Url" /><asp:Label ID="txtGithubError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtLinkedin" Text="LinkedIn URL" /><asp:TextBox ID="txtLinkedin" runat="server" TextMode="Url" /><asp:Label ID="txtLinkedinError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtPortfolio" Text="Portfolio URL" /><asp:TextBox ID="txtPortfolio" runat="server" TextMode="Url" /><asp:Label ID="txtPortfolioError" runat="server" CssClass="field-error" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtCV
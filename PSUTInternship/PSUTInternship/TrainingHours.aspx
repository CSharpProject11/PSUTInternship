<%@ Page Language="C#" Async="true" AutoEventWireup="true" CodeBehind="TrainingHours.aspx.cs" Inherits="PSUTInternship.TrainingHours" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Training hours | PSUT</title><link href="Content/vendor/bootstrap.min.css" rel="stylesheet"/><link href="Content/portal.css" rel="stylesheet"/></head><body>
<main class="container py-5"><a href="<%= ResolveUrl(PSUTInternship.Shared.PortalRoles.Dashboard(Convert.ToString(Session["userRole"]))) %>">Back to dashboard</a><h1 class="mt-4">Training hours</h1><p>Hours count toward completion after your company supervisor approves them.</p>
<form id="form1" runat="server"><asp:Label ID="notice" runat="server" role="status" />
<asp:Panel ID="entry" runat="server" CssClass="row g-3 mb-4"><div class="col-md-3"><label for="day">Training date</label><asp:TextBox ID="day" runat="server" TextMode="Date" CssClass="form-control"/></div><div class="col-md-2"><label for="hours">Hours</label><asp:TextBox ID="hours" runat="server" CssClass="form-control"/></div><div class="col-md-5"><label for="description">Work completed</label><asp:TextBox ID="description" runat="server" CssClass="form-control"/></div><div class="col-md-2 align-self-end"><asp:Button ID="submit" runat="server" Text="Submit hours" OnClick="submit_Click" CssClass="btn btn-primary"/></div></asp:Panel>
<div class="table-responsive"><asp:GridView ID="records" runat="server" AutoGenerateColumns="false" OnRowCommand="records_RowCommand" CssClass="table" EmptyDataText="No training hours have been logged yet."><Columns><asp:BoundField DataField="Student" HeaderText="Student"/><asp:BoundField DataField="Date" HeaderText="Date"/><asp:BoundField DataField="Hours" HeaderText="Hours"/><asp:BoundField DataField="Description" HeaderText="Work completed"/><asp:BoundField DataField="Status" HeaderText="Status"/><asp:TemplateField><ItemTemplate><asp:Button runat="server" Text="Approve" CommandName="ApproveHours" CommandArgument='<%# Eval("Id") %>' Visible='<%# CanReview %>'/><asp:Button runat="server" Text="Reject" CommandName="RejectHours" CommandArgument='<%# Eval("Id") %>' Visible='<%# CanReview %>'/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></form></main></body></html>

<%@ Page Title="Final internship review" MasterPageFile="~/Portal.Master" Language="C#" Async="true" AutoEventWireup="true" CodeBehind="CompletionReview.aspx.cs" Inherits="PSUTInternship.Admin.CompletionReview" %>
<asp:Content ID="PageHead" ContentPlaceHolderID="PortalHead" runat="server"><link rel="stylesheet" href="Coordinator.css?v=review4" /><link rel="stylesheet" href="CompletionReview.css?v=1" /></asp:Content>
<asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server"><h1>Final internship review</h1><p>Review both evaluations and completion requirements before issuing a certificate.</p><asp:Label ID="notice" runat="server" role="status"/>
<asp:Repeater ID="reviews" runat="server" OnItemCommand="reviews_ItemCommand"><ItemTemplate><section class="panel"><h2><%#: Eval("Name") %></h2><p><%#: Eval("Status") %></p><button type="button" class="btn" onclick="this.nextElementSibling.showModal()">View final review</button><dialog class="final-review-dialog"><header><h2>Final Internship Review</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Close review">×</button></header><div class="review-body"><div class="review-student-banner"><h3><%#: Eval("Name") %></h3><p>University ID: <%#: Eval("StudentNumber") %></p></div><div class="review-detail-grid"><p>Approved hours<br><strong><%#: Eval("Hours") %></strong></p><p>Completion<br><strong><%#: Eval("Percent") %>%</strong></p><p>Placement<br><strong><%#: Eval("Placement") %></strong></p><p>Recommendation<br><strong><%#: Eval("Recommendation") %></strong></p></div><progress max="100" value='<%#: Eval("Percent") %>'></progress><div class="review-detail-grid"><section class="review-evaluation"><h3>Company evaluation</h3><p><%#: Eval("CompanyScore") %></p><p class="review-comments"><%#: Eval("CompanyComments") %></p></section><section class="review-evaluation"><h3>Academic evaluation</h3><p><%#: Eval("AcademicScore") %></p><p class="review-comments"><%#: Eval("AcademicComments") %></p></section></div><section class="review-requirements"><h3>Completion requirements</h3><ul><li>Assigned tasks reviewed: <%#: Eval("TasksReady") %></li><li>Approved training hours: <%#: Eval("HoursReady") %></li><li>Company evaluation: <%#: Eval("CompanyReady") %></li><li>Academic evaluation: <%#: Eval("AcademicReady") %></li><li>Passing recommendation: <%#: Eval("Recommendation") %></li></ul></section><p class="review-note">Certificate creation becomes available once all requirements are met. Tasks, grades and supervisor assignments are verified again on approval.</p></div><div class="review-actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Close</button><asp:Button runat="server" Text="Create Certificate" CommandName="Approve" CommandArgument='<%# Eval("Id") %>' CssClass="btn certificate-create" Enabled='<%# Convert.ToBoolean(Eval("Ready")) && Convert.ToString(Eval("Status")) != "approved" %>'/><asp:HyperLink runat="server" CssClass="btn" Visible='<%# Convert.ToString(Eval("Status")) == "approved" %>' NavigateUrl='<%# "../CompletionReport.aspx?studentId=" + Server.UrlEncode(Convert.ToString(Eval("StudentId"))) %>' Text="Download approved certificate" /></div></dialog></section></ItemTemplate></asp:Repeater><asp:Label ID="empty" runat="server" Text="No evaluations have been forwarded for review yet."/>
</asp:Content>

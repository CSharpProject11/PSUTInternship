<%@ Page Title="Final internship review" MasterPageFile="~/Portal.Master" Language="C#" Async="true" AutoEventWireup="true" CodeBehind="CompletionReview.aspx.cs" Inherits="PSUTInternship.Admin.CompletionReview" %>
<asp:Content ID="PageHead" ContentPlaceHolderID="PortalHead" runat="server"><link rel="stylesheet" href="Coordinator.css?v=review4" /><link rel="stylesheet" href="CompletionReview.css?v=3" /></asp:Content>
<asp:Content ID="PageContent" ContentPlaceHolderID="PortalContent" runat="server"><div class="completion-review-page"><div class="completion-heading"><h1>Completion review</h1><p>Verify final evaluations and training requirements before issuing a certificate.</p></div><asp:Label ID="notice" runat="server" role="status"/>
<div class="completion-filters" role="search" aria-label="Search completion reviews">
<div class="completion-search-field"><asp:Label runat="server" AssociatedControlID="reviewSearch" Text="Search"/><asp:TextBox ID="reviewSearch" runat="server" placeholder="Student name, university ID or company" MaxLength="150" TextMode="Search"/></div>
<div class="completion-status-field"><asp:Label runat="server" AssociatedControlID="reviewFilter" Text="Completion status"/><asp:DropDownList ID="reviewFilter" runat="server"><asp:ListItem Value="All" Text="All reviews"/><asp:ListItem Value="Ready" Text="Ready for review"/><asp:ListItem Value="Pending" Text="Requirements pending"/><asp:ListItem Value="Approved" Text="Approved"/></asp:DropDownList></div>
<asp:Button ID="applyFilters" runat="server" Text="Apply filters" CssClass="btn" OnClick="applyFilters_Click"/>
<a class="completion-reset" href="CompletionReview.aspx">Reset</a>
<asp:Label ID="resultCount" runat="server" CssClass="completion-result-count" role="status" aria-live="polite"/>
</div>
<asp:Repeater ID="reviews" runat="server" OnItemCommand="reviews_ItemCommand"><HeaderTemplate><section class="completion-register"><div class="completion-register-heading"><h2>Student completion register</h2><p>Review the evidence, then approve eligible internships.</p></div><div class="completion-table-scroll"><table class="completion-table"><thead><tr><th scope="col">Student</th><th scope="col">Placement</th><th scope="col">Approved hours</th><th scope="col">Academic review</th><th scope="col">Completion status</th><th scope="col">Action</th></tr></thead><tbody></HeaderTemplate><ItemTemplate><tr><td><strong><%#: Eval("Name") %></strong><small>ID: <%#: Eval("StudentNumber") %></small></td><td><%#: Eval("Placement") %></td><td class="completion-hours"><%#: Eval("Hours") %> hrs</td><td><span class='completion-result' data-result='<%#: Eval("AcademicResult") %>'><%#: Eval("AcademicResult") %></span></td><td><span class="completion-state"><%#: Convert.ToString(Eval("Status")) == "approved" ? "Approved" : Convert.ToBoolean(Eval("Ready")) ? "Ready for review" : "Requirements pending" %></span></td><td><button type="button" class="btn" onclick="this.nextElementSibling.showModal()">View final review</button><dialog class="final-review-dialog"><header><h2>Final Internship Review</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Close review">×</button></header><div class="review-body"><div class="review-student-banner"><h3><%#: Eval("Name") %></h3><p>University ID: <%#: Eval("StudentNumber") %></p></div><div class="review-detail-grid"><p>Approved hours<br><strong><%#: Eval("Hours") %></strong></p><p>Completion<br><strong><%#: Eval("Percent") %>%</strong></p><p>Placement<br><strong><%#: Eval("Placement") %></strong></p><p>Academic result<br><strong><%#: Eval("Recommendation") %></strong></p></div><progress max="100" value='<%#: Eval("Percent") %>'></progress><div class="review-detail-grid"><section class="review-evaluation"><h3>Company evaluation</h3><p><%#: Eval("CompanyScore") %></p><p class="review-comments"><%#: Eval("CompanyComments") %></p></section><section class="review-evaluation"><h3>Academic evaluation</h3><p><%#: Eval("AcademicResult") %></p><p class="review-comments"><%#: Eval("AcademicComments") %></p></section></div><section class="review-requirements"><h3>Completion requirements</h3><div class="completion-table-scroll"><table class="requirements-table"><thead><tr><th scope="col">Requirement</th><th scope="col">Evidence</th><th scope="col">Result</th></tr></thead><tbody>
<tr><th scope="row">Assigned tasks</th><td>All assigned tasks reviewed</td><td><%#: Eval("TasksReady") %></td></tr>
<tr><th scope="row">Training hours</th><td><%#: Eval("Hours") %> approved hours</td><td><%#: Eval("HoursReady") %></td></tr>
<tr><th scope="row">Company evaluation</th><td>Final evaluation submitted</td><td><%#: Eval("CompanyReady") %></td></tr>
<tr><th scope="row">Academic evaluation</th><td>Final review submitted</td><td><%#: Eval("AcademicReady") %></td></tr>
<tr><th scope="row">Academic result</th><td>Pass required for completion</td><td><span class="completion-result" data-result='<%#: Eval("AcademicResult") %>'><%#: Eval("AcademicResult") %></span></td></tr>
</tbody></table></div></section><p class="review-note">Certificate creation becomes available once all requirements are met. Tasks, grades and supervisor assignments are verified again on approval.</p></div><div class="review-actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Close</button><asp:Button runat="server" Text="Create Certificate" CommandName="Approve" CommandArgument='<%# Eval("Id") %>' CssClass="btn certificate-create" Enabled='<%# Convert.ToBoolean(Eval("Ready")) && Convert.ToString(Eval("Status")) != "approved" %>'/><asp:HyperLink runat="server" CssClass="btn" Visible='<%# Convert.ToString(Eval("Status")) == "approved" %>' NavigateUrl='<%# "../CompletionReport.aspx?studentId=" + Server.UrlEncode(Convert.ToString(Eval("StudentId"))) %>' Text="Download approved certificate" /></div></dialog></td></tr></ItemTemplate><FooterTemplate></tbody></table></div></section></FooterTemplate></asp:Repeater><asp:Label ID="empty" runat="server" CssClass="completion-empty" Text="No evaluations have been forwarded for review yet."/></div>
</asp:Content>

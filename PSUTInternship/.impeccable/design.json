  "title": "Design System: PSUT Internship Portal",
  "narrative": {
    "northStar": "Campus in motion, purposeful workspaces",
    "keyCharacteristics": [
      "Authentic PSUT photography and institutional blue.",
      "Generous curved media with pill actions.",
      "Compact, shared role workspaces with clear data hierarchy.",
      "Motion that supports exploration and respects reduced motion."
    ],
    "overview": "Extend the supplied PSUT identity into student, company, academic and coordinator workspaces. Authentic campus photography, institutional blue and self-hosted Manrope connect a generous editorial homepage to compact operational screens. The homepage expresses movement through film framing and draggable editorial rails; authenticated workspaces bring the same identity to decisions and records.\n\nThe visual authority is the supplied PSUT homepage and its existing design document. Armenia Travel informs scroll choreography and editorial rails; Dashboard V14 informs compact navigation and information density. Neither reference replaces PSUT branding.",
    "rules": [
      {
        "name": "The PSUT Identity Rule",
        "body": "Keep the institutional palette and authentic university imagery across roles; role differences come from content and permissions.",
        "section": "colors"
      },
      {
        "name": "The Truthful Workspace Rule",
        "body": "Render authenticated records, real zero states and explicit unavailable states. A dash indicating unavailable access is not a zero. Label isolated preview data as illustrative; do not borrow its figures for production.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve authentic PSUT campus photography and supplied logo assets.",
      "Do retain a clear hierarchy from role-specific heading to current decisions and activity.",
      "Do provide visible keyboard focus, accessible names and reduced-motion behavior.",
      "Do distinguish unavailable data, genuine empty data and illustrative previews."
    ],
    "donts": [
      "Don't invent statistics to fill a dashboard.",
      "Don't introduce a separate brand or palette for each role.",
      "Don't require dragging or animation to reach essential content.",
      "Don't hide keyboard-focusable controls with opacity alone."
    ]
  }
